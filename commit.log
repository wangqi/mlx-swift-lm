+        // Causal boundary: this query can attend to tokens 0..q_abs (inclusive)
+        uint q_abs = q_offset + q_within_L;
+
+        // Token range for this block
+        uint t_start = block_idx * BlockSize;
+        uint t_end = t_start + BlockSize;
