+//
+//  Qwen35.swift
+//  mlx-swift-lm
+//
+//  Created by John Mai on 2026/2/25.
+//
+//  Port of https://github.com/Blaizzy/mlx-vlm/tree/main/mlx_vlm/models/qwen3_5
