diff --git a/Tests/MLXLMTests/ModelLoadProgressTests.swift b/Tests/MLXLMTests/ModelLoadProgressTests.swift
new file mode 100644
index 0000000..715bf42
--- /dev/null
+++ b/Tests/MLXLMTests/ModelLoadProgressTests.swift
@@ -0,0 +1,281 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLX
+import MLXNN
+import Testing
+
+@testable import MLXLMCommon
+
+@Suite("Model load progress")
+struct ModelLoadProgressTests {
+
+    private final class Model: Module, BaseLanguageModel {
+        @ModuleInfo var layer = Linear(64, 64, bias: false)
+    }
+
+    @Test("the handlers group in one value")
+    func handlersGroupBothPhases() {
+        let weights: @Sendable (Progress) -> Void = { _ in }
+        let download: @Sendable (Progress) -> Void = { _ in }
+
+        let both = LoadProgressHandlers(download: download, weights: weights)
+        #expect(both.download != nil)
+        #expect(both.weights != nil)
+
+        // the memberwise init has defaults, so the empty value exists
+        let none = LoadProgressHandlers()
+        #expect(none.download == nil)
+        #expect(none.weights == nil)
+    }
+
+    @Test("the static factories select a single phase")
+    func handlerFactories() {
+        let handler: @Sendable (Progress) -> Void = { _ in }
+
+        #expect(LoadProgressHandlers.weights(handler).weights != nil)
+        #expect(LoadProgressHandlers.weights(handler).download == nil)
+        #expect(LoadProgressHandlers.download(handler).download != nil)
+        #expect(LoadProgressHandlers.download(handler).weights == nil)
+    }
+
+    /// Recorder for the `Progress` published by ``ModelLoadProgressReporter``.
+    final class Recorder: @unchecked Sendable {
+        private let lock = NSLock()
+        private var values = [(completed: Int64, total: Int64)]()
+
+        func record(_ progress: Progress) {
+            lock.withLock {
+                values.append((progress.completedUnitCount, progress.totalUnitCount))
+            }
+        }
+
+        var completed: [Int64] {
+            lock.withLock { values.map(\.completed) }
+        }
+
+        var fractions: [Double] {
+            lock.withLock {
+                values.map { $0.total > 0 ? Double($0.completed) / Double($0.total) : 0 }
+            }
+        }
+    }
+
+    private func makeDirectory() throws -> URL {
+        let directory = FileManager.default.temporaryDirectory
+            .appending(path: UUID().uuidString, directoryHint: .isDirectory)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        return directory
+    }
+
+    private func write(_ byteCount: Int, to url: URL) throws {
+        try Data(repeating: 0, count: byteCount).write(to: url)
+    }
+
+    @Test("byte count sums the shards and ignores other files")
+    func safetensorsByteCountSumsShards() throws {
+        let directory = try makeDirectory()
+        defer { try? FileManager.default.removeItem(at: directory) }
+
+        try write(1024, to: directory.appending(path: "model-00001-of-00002.safetensors"))
+        try write(2048, to: directory.appending(path: "model-00002-of-00002.safetensors"))
+
+        // not weights -- must not be counted
+        try write(64, to: directory.appending(path: "config.json"))
+        try write(64, to: directory.appending(path: "tokenizer.json"))
+
+        #expect(safetensorsByteCount(in: directory) == 3072)
+    }
+
+    @Test("byte count follows the safetensors index")
+    func safetensorsByteCountUsesIndex() throws {
+        let directory = try makeDirectory()
+        defer { try? FileManager.default.removeItem(at: directory) }
+
+        try write(1024, to: directory.appending(path: "model-00001-of-00002.safetensors"))
+        try write(2048, to: directory.appending(path: "model-00002-of-00002.safetensors"))
+        try write(4096, to: directory.appending(path: "stale.safetensors"))
+
+        let index = """
+            {
+              "weight_map": {
+                "model.layers.0.weight": "model-00001-of-00002.safetensors",
+                "model.layers.1.weight": "model-00002-of-00002.safetensors"
+              }
+            }
+            """
+        try Data(index.utf8).write(
+            to: directory.appending(path: "model.safetensors.index.json"))
+
+        #expect(safetensorsByteCount(in: directory) == 3072)
+    }
+
+    @Test("byte count of a directory without weights is zero")
+    func safetensorsByteCountWithoutWeights() throws {
+        let directory = try makeDirectory()
+        defer { try? FileManager.default.removeItem(at: directory) }
+
+        try write(64, to: directory.appending(path: "config.json"))
+
+        #expect(safetensorsByteCount(in: directory) == 0)
+        #expect(safetensorsByteCount(in: directory.appending(path: "missing")) == 0)
+    }
+
+    @Test("progress of the individual files is aggregated")
+    func reporterAggregatesAcrossFiles() {
+        let first = URL(filePath: "/tmp/first.safetensors")
+        let second = URL(filePath: "/tmp/second.safetensors")
+
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(totalUnitCount: 300) { recorder.record($0) }
+
+        reporter.update(.init(url: first, completedUnitCount: 0, totalUnitCount: 100))
+        reporter.update(.init(url: second, completedUnitCount: 0, totalUnitCount: 200))
+        reporter.update(.init(url: first, completedUnitCount: 100, totalUnitCount: 100))
+        reporter.update(.init(url: second, completedUnitCount: 200, totalUnitCount: 200))
+
+        // Completion is reserved for a successful load.
+        #expect(recorder.completed.last == 299)
+        reporter.finish()
+        #expect(recorder.fractions.last == 1)
+        #expect(recorder.completed == recorder.completed.sorted())
+    }
+
+    @Test("concurrent readers of one file contribute independently")
+    func reporterAggregatesConcurrentReaders() {
+        let url = URL(filePath: "/tmp/weights.safetensors")
+        let first = UUID()
+        let second = UUID()
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(totalUnitCount: 1000) { recorder.record($0) }
+
+        reporter.update(
+            .init(url: url, completedUnitCount: 100, totalUnitCount: 1000), worker: first)
+        reporter.update(
+            .init(url: url, completedUnitCount: 150, totalUnitCount: 1000), worker: second)
+        reporter.update(
+            .init(url: url, completedUnitCount: 200, totalUnitCount: 1000), worker: first)
+
+        #expect(recorder.completed == [100, 250, 350])
+    }
+
+    @Test("published progress remains a snapshot")
+    func progressIsSnapshot() {
+        final class Snapshots: @unchecked Sendable {
+            var values = [Progress]()
+        }
+        let snapshots = Snapshots()
+        let reporter = ModelLoadProgressReporter(totalUnitCount: 100) {
+            snapshots.values.append($0)
+        }
+        let url = URL(filePath: "/tmp/weights.safetensors")
+        reporter.update(.init(url: url, completedUnitCount: 25, totalUnitCount: 100))
+        reporter.update(.init(url: url, completedUnitCount: 75, totalUnitCount: 100))
+
+        #expect(snapshots.values.map(\.completedUnitCount) == [25, 75])
+    }
+
+    @Test("checkpoint workers report progress before loading finishes")
+    func checkpointWorkersReportProgress() throws {
+        let directory = try makeDirectory()
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let url = directory.appending(path: "model.safetensors")
+        try save(arrays: ["weight": MLXArray(Array(repeating: Float(1), count: 4096))], url: url)
+
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(
+            totalUnitCount: safetensorsByteCount(in: directory)
+        ) {
+            recorder.record($0)
+        }
+        _ = try ModelLoadProgressScope.$reporter.withValue(reporter) {
+            try loadModelCheckpoint(urls: [url])
+        }
+
+        #expect(!recorder.completed.isEmpty)
+        #expect(recorder.completed.last ?? 0 > 0)
+    }
+
+    @Test("async model loading forwards progress to its workers")
+    func asyncModelLoadingReportsProgress() async throws {
+        let directory = try makeDirectory()
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let source = Model()
+        eval(source)
+        try save(
+            arrays: Dictionary(uniqueKeysWithValues: source.parameters().flattened()),
+            url: directory.appending(path: "model.safetensors"))
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(
+            totalUnitCount: safetensorsByteCount(in: directory)
+        ) {
+            recorder.record($0)
+        }
+
+        try await ModelLoadProgressScope.$reporter.withValue(reporter) {
+            try await loadWeights(modelDirectory: directory, model: Model())
+        }
+
+        #expect((recorder.completed.last ?? 0) > 0)
+    }
+
+    @Test("updates are coalesced")
+    func reporterCoalescesUpdates() {
+        let url = URL(filePath: "/tmp/weights.safetensors")
+        let total: Int64 = 1_000_000
+
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(totalUnitCount: total) { recorder.record($0) }
+
+        // one update per byte would be 1_000_000 callbacks
+        for completed in stride(from: Int64(0), through: total, by: 1) {
+            reporter.update(
+                .init(url: url, completedUnitCount: completed, totalUnitCount: total))
+        }
+
+        #expect(recorder.completed.count <= 1001)
+        #expect(recorder.completed.first == 0)
+    }
+
+    @Test("finish publishes completion")
+    func reporterFinishCompletes() {
+        let url = URL(filePath: "/tmp/weights.safetensors")
+
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(totalUnitCount: 1000) { recorder.record($0) }
+
+        // a model whose weights are partly dropped by sanitize() never reads every byte
+        reporter.update(.init(url: url, completedUnitCount: 400, totalUnitCount: 1000))
+        #expect(recorder.fractions.last == 0.4)
+
+        reporter.finish()
+        #expect(recorder.fractions.last == 1)
+    }
+
+    @Test("completion is reserved for a successful load")
+    func reporterReservesCompletion() {
+        let url = URL(filePath: "/tmp/weights.safetensors")
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(totalUnitCount: 100) { recorder.record($0) }
+
+        reporter.update(.init(url: url, completedUnitCount: 100, totalUnitCount: 100))
+        #expect(recorder.completed == [99])
+        reporter.update(.init(url: url, completedUnitCount: 100, totalUnitCount: 100))
+        #expect(recorder.completed == [99])
+        reporter.finish()
+        reporter.update(.init(url: url, completedUnitCount: 100, totalUnitCount: 100))
+        reporter.finish()
+        #expect(recorder.completed == [99, 100])
+    }
+
+    @Test("a model without weights still completes")
+    func reporterWithoutWeights() {
+        let recorder = Recorder()
+        let reporter = ModelLoadProgressReporter(totalUnitCount: 0) { recorder.record($0) }
+
+        reporter.finish()
+
+        #expect(recorder.completed.last == 1)
+        #expect(recorder.fractions.last == 1)
+    }
+}

commit 22bdf2c2d6912d8d465a62860f909c70a6bbeade
Author: Tolga Unal <115488770+unaltolga@users.noreply.github.com>
Date:   Fri Nov 6 12:06:28 2026 -0500

    Decode surrogate pairs and the remaining Python escapes (#769)
    
    PythonLiteralParser kept the backslash for \x, octal, \a and \v escapes
    and for a line continuation, though Python decodes them. A surrogate
    pair written as two \u escapes made it reject the whole literal, so the
    Pythonic parser passed the raw text, quotes included, to the tool.

diff --git a/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift b/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift
index 9edb860..fc37e5e 100644
--- a/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift
+++ b/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift
@@ -128,10 +128,21 @@ struct PythonLiteralParser {
             case "n": result.append("\n")
             case "r": result.append("\r")
             case "t": result.append("\t")
+            case "a": result.append("\u{7}")
             case "b": result.append("\u{8}")
             case "f": result.append("\u{c}")
+            case "v": result.append("\u{b}")
+            case "\n", "\r\n", "\r":
+                // A backslash at the end of a line continues the string.
+                break
+            case "0", "1", "2", "3", "4", "5", "6", "7":
+                guard let scalar = parseOctalEscape(startingWith: escaped) else { return nil }
+                result.unicodeScalars.append(scalar)
+            case "x":
+                guard let scalar = parseUnicodeScalar(digitCount: 2) else { return nil }
+                result.unicodeScalars.append(scalar)
             case "u":
-                guard let scalar = parseUnicodeScalar(digitCount: 4) else { return nil }
+                guard let scalar = parseUTF16Escape() else { return nil }
                 result.unicodeScalars.append(scalar)
             case "U":
                 guard let scalar = parseUnicodeScalar(digitCount: 8) else { return nil }
@@ -145,7 +156,35 @@ struct PythonLiteralParser {
         return nil
     }
 
+    /// Joins a surrogate pair written as two `\u` escapes, as JSON does.
+    private mutating func parseUTF16Escape() -> Unicode.Scalar? {
+        guard let high = parseHexValue(digitCount: 4) else { return nil }
+        guard (0xD800 ... 0xDBFF).contains(high) else { return Unicode.Scalar(high) }
+
+        guard consume("\\"), consume("u"),
+            let low = parseHexValue(digitCount: 4),
+            (0xDC00 ... 0xDFFF).contains(low)
+        else { return nil }
+        return Unicode.Scalar(0x10000 + ((high - 0xD800) << 10) + (low - 0xDC00))
+    }
+
+    /// Reads up to three octal digits, as Python does.
+    private mutating func parseOctalEscape(startingWith first: Character) -> Unicode.Scalar? {
+        var digits = String(first)
+        while digits.count < 3, let character = current,
+            UInt32(String(character), radix: 8) != nil
+        {
+            digits.append(character)
+            advance()
+        }
+        return UInt32(digits, radix: 8).flatMap { Unicode.Scalar($0) }
+    }
+
     private mutating func parseUnicodeScalar(digitCount: Int) -> Unicode.Scalar? {
+        parseHexValue(digitCount: digitCount).flatMap { Unicode.Scalar($0) }
+    }
+
+    private mutating func parseHexValue(digitCount: Int) -> UInt32? {
         var digits = ""
         digits.reserveCapacity(digitCount)
 
@@ -157,8 +196,7 @@ struct PythonLiteralParser {
             advance()
         }
 
-        guard let value = UInt32(digits, radix: 16) else { return nil }
-        return Unicode.Scalar(value)
+        return UInt32(digits, radix: 16)
     }
 
     private mutating func parseAtom() -> (any Sendable)? {
diff --git a/Tests/MLXLMTests/ToolArgumentNormalizationTests.swift b/Tests/MLXLMTests/ToolArgumentNormalizationTests.swift
index ce82527..b914b59 100644
--- a/Tests/MLXLMTests/ToolArgumentNormalizationTests.swift
+++ b/Tests/MLXLMTests/ToolArgumentNormalizationTests.swift
@@ -167,4 +167,19 @@ struct ToolArgumentNormalizationTests {
         #expect(tryParsePythonLiteral("['SF',") == nil)
         #expect(tryParsePythonLiteral("[f()]") == nil)
     }
+
+    @Test("Python string escapes decode as Python does")
+    func pythonStringEscapes() {
+        for (literal, value) in [
+            (#"'\x41\101\0'"#, "AA\0"),
+            (#"'\a\v'"#, "\u{7}\u{b}"),
+            ("'line\\\nnext'", "linenext"),
+            (#"'\ud83d\ude00'"#, "\u{1F600}"),
+            (#"'\d'"#, #"\d"#),
+        ] {
+            #expect(tryParsePythonLiteral(literal) as? String == value)
+        }
+        #expect(tryParsePythonLiteral(#"'\ud83d'"#) == nil)
+        #expect(tryParsePythonLiteral(#"'\x4'"#) == nil)
