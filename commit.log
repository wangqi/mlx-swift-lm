commit 2775ddde93ab320c85d75f97ee653d4b5a9f59b3
Author: ahuzmeza <32289581+ahuzmeza@users.noreply.github.com>
Date:   Tue Nov 3 20:23:36 2026 +0200

    RotatingKVCache: keep the pinned prefix visible in multi-token masks (#747)
    
    * RotatingKVCache: keep the pinned prefix visible in multi-token masks
    
    makeMask applied a plain maxSize window over the cache rows for multi-token
    writes. Once rows had been evicted, every query after the first lost the
    `keep` prefix that one-token decoding keeps, so chunked prefill and
    multi-token writes after a wrap attended to a different context.
    
    With keep > 0 and the default window, the prefix now takes `keep` slots and
    the most recent rows take the rest. A different window size keeps the old
    mask. This matches ml-explore/mlx-lm#1978.
    
    Fixes #742.

diff --git a/Libraries/MLXLMCommon/KVCache.swift b/Libraries/MLXLMCommon/KVCache.swift
index 213923d..3a41ea6 100644
--- a/Libraries/MLXLMCommon/KVCache.swift
+++ b/Libraries/MLXLMCommon/KVCache.swift
@@ -1058,8 +1058,19 @@ public class RotatingKVCache: BaseKVCache, CustomDebugStringConvertible {
 
             // Decide if we need an array mask
             if cappedOffset + n > actualWindowSize || returnArray {
-                return .array(
-                    createCausalMask(n: n, offset: cappedOffset, windowSize: actualWindowSize))
+                // A different attention window must not force the pinned prefix visible.
+                guard keep > 0, actualWindowSize == maxCacheSize else {
+                    return .array(
+                        createCausalMask(n: n, offset: cappedOffset, windowSize: actualWindowSize))
+                }
+                // The pinned prefix uses `keep` slots of the window; recent rows use the rest.
+                let rinds = MLXArray(Int32(0) ..< Int32(cappedOffset + n))[.newAxis]
+                let linds = MLXArray(Int32(cappedOffset) ..< Int32(cappedOffset + n))[
+                    0..., .newAxis]
+                let causal = linds .>= rinds
+                let pinned = rinds .< keep
+                let recent = linds .< rinds + (actualWindowSize - keep)
+                return .array(causal & (pinned | recent))
             }
             return .causal
         } else {
diff --git a/Tests/MLXLMTests/RotatingKVCacheKeepMaskTests.swift b/Tests/MLXLMTests/RotatingKVCacheKeepMaskTests.swift
new file mode 100644
index 0000000..d134c54
--- /dev/null
+++ b/Tests/MLXLMTests/RotatingKVCacheKeepMaskTests.swift
@@ -0,0 +1,87 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLX
+import Testing
+
+@testable import MLXLMCommon
+
+/// Token ids each query of an `n`-token write can see, read from the mask and the returned keys.
+private func visibleTokens(
+    _ cache: RotatingKVCache, history: Int, n: Int, windowSize: Int?, returnArray: Bool
+) -> [[Int]] {
+    let mask = cache.makeMask(n: n, windowSize: windowSize, returnArray: returnArray)
+    let kv = MLXArray(Int32(history) ..< Int32(history + n)).reshaped(1, 1, n, 1)
+    let (keys, _) = cache.update(keys: kv, values: kv)
+    let ids = keys[0, 0, 0..., 0].asArray(Int32.self).map(Int.init)
+    let rows: [[Bool]]? =
+        switch mask {
+        case .array(let array):
+            (0 ..< n).map { array[$0].asArray(Bool.self) }
+        default:
+            nil
+        }
+    return (0 ..< n).map { row in
+        let end = history + row + 1
+        let visible = ids.indices.filter { col in
+            if let rows { rows[row][col] } else { ids[col] < end }
+        }
+        return visible.map { ids[$0] }.sorted()
+    }
+}
+
+@Suite struct RotatingKVCacheKeepMaskTests {
+
+    @Test func multiTokenWritesSeeThePinnedPrefixLikeOneByOneDecoding() {
+        for size in [2, 4, 8] {
+            for keep in Set([0, 1, size - 1]).sorted() {
+                for history in [0, 1, size - 1, size, 2 * size + 3] {
+                    for step in [1, size + 1] {
+                        for n in [2, 3, size + 2] {
+                            for windowSize in [nil, size] {
+                                for returnArray in [false, true] {
+                                    let cache = RotatingKVCache(maxSize: size, keep: keep)
+                                    for start in stride(from: 0, to: history, by: step) {
+                                        let end = Swift.min(start + step, history)
+                                        let kv = MLXArray(Int32(start) ..< Int32(end))
+                                            .reshaped(1, 1, end - start, 1)
+                                        _ = cache.update(keys: kv, values: kv)
+                                    }
+                                    let visible = visibleTokens(
+                                        cache, history: history, n: n, windowSize: windowSize,
+                                        returnArray: returnArray)
+                                    for row in 0 ..< n {
+                                        let end = history + row + 1
+                                        let recent = Swift.min(
+                                            Swift.max(keep, end - (size - keep)), end)
+                                        let expected =
+                                            Array(0 ..< Swift.min(keep, end))
+                                            + Array(recent ..< end)
+                                        #expect(
+                                            visible[row] == expected,
+                                            "size \(size) keep \(keep) history \(history) step \(step) n \(n) window \(String(describing: windowSize)) array \(returnArray) row \(row)"
+                                        )
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    @Test func smallerWindowDoesNotForceThePinnedPrefixVisible() {
+        let cache = RotatingKVCache(maxSize: 4, keep: 1)
+        for returnArray in [false, true] {
+            guard
+                case .array(let mask) = cache.makeMask(
+                    n: 3, windowSize: 2, returnArray: returnArray)
+            else {
+                Issue.record("expected an array mask")
+                continue
+            }
+            #expect(mask[2].asArray(Bool.self) == [false, true, true])
+        }
+    }
+}

