diff --git a/Tests/MLXLMTests/KVCacheTypeRegistryTests.swift b/Tests/MLXLMTests/KVCacheTypeRegistryTests.swift
new file mode 100644
index 0000000..db886db
--- /dev/null
+++ b/Tests/MLXLMTests/KVCacheTypeRegistryTests.swift
@@ -0,0 +1,164 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLX
+import Testing
+
+@testable import MLXLMCommon
+
+/// Stores token ids, standing in for a cache type defined outside MLXLMCommon.
+private final class TokenListCache: BaseKVCache {
+    override static var serializedClassName: String? { "Tests.TokenListCache" }
+
+    var tokens: [Int32]
+
+    init(tokens: [Int32]) {
+        self.tokens = tokens
+        super.init()
+        offset = tokens.count
+    }
+
+    override var state: [MLXArray] {
+        get { [MLXArray(tokens)] }
+        set { tokens = newValue.first?.asArray(Int32.self) ?? [] }
+    }
+
+    override var metaState: [String] {
+        get { [String(offset)] }
+        set { offset = newValue.first.flatMap(Int.init) ?? tokens.count }
+    }
+
+    override var isTrimmable: Bool { true }
+
+    override func copy() -> any KVCache { TokenListCache(tokens: tokens) }
+
+    override static func restore(state: [MLXArray], metaState: [String]) throws -> any KVCache {
+        let cache = TokenListCache(tokens: state.first?.asArray(Int32.self) ?? [])
+        cache.metaState = metaState
+        return cache
+    }
+}
+
+private final class OtherTokenListCache: BaseKVCache {
+    override static var serializedClassName: String? { "Tests.TokenListCache" }
+    override func copy() -> any KVCache { OtherTokenListCache() }
+    override static func restore(state: [MLXArray], metaState: [String]) throws -> any KVCache {
+        OtherTokenListCache()
+    }
+}
+
+private final class BuiltInNameCache: BaseKVCache {
+    override static var serializedClassName: String? { "KVCacheSimple" }
+    override func copy() -> any KVCache { BuiltInNameCache() }
+}
+
+/// Never registered explicitly, so only saving registers it.
+private final class SavedOnlyCache: BaseKVCache {
+    override static var serializedClassName: String? { "Tests.SavedOnlyCache" }
+    override func copy() -> any KVCache { SavedOnlyCache() }
+    override static func restore(state: [MLXArray], metaState: [String]) throws -> any KVCache {
+        SavedOnlyCache()
+    }
+}
+
+private final class UnnamedCache: BaseKVCache {
+    override func copy() -> any KVCache { UnnamedCache() }
+}
+
+private final class InheritedNameCache: KVCacheSimple {}
+
+struct KVCacheTypeRegistryTests {
+
+    static func temporaryURL() -> URL {
+        FileManager.default.temporaryDirectory
+            .appending(component: "prompt-cache-\(UUID().uuidString).safetensors")
+    }
+
+    @Test func `a registered custom cache saves and restores with built-in caches`() throws {
+        try registerKVCacheType(TokenListCache.self)
+
+        let simple = KVCacheSimple()
+        _ = simple.update(keys: MLXArray.ones([1, 2, 3, 8]), values: MLXArray.ones([1, 2, 3, 8]))
+        let custom = TokenListCache(tokens: [7, 8, 9])
+
+        let url = Self.temporaryURL()
+        defer { try? FileManager.default.removeItem(at: url) }
+        try savePromptCache(url: url, cache: [simple, custom])
+
+        let restored = try loadPromptCacheSnapshot(url: url).cache
+        #expect(restored.count == 2)
+        #expect(restored[0] is KVCacheSimple)
+        #expect(restored[0].offset == 3)
+        let tokens = try #require(restored[1] as? TokenListCache)
+        #expect(tokens.tokens == [7, 8, 9])
+        #expect(tokens.offset == 3)
+    }
+
+    @Test func `a custom cache inside a CacheList round-trips`() throws {
+        try registerKVCacheType(TokenListCache.self)
+
+        let url = Self.temporaryURL()
+        defer { try? FileManager.default.removeItem(at: url) }
+        try savePromptCache(
+            url: url, cache: [CacheList(KVCacheSimple(), TokenListCache(tokens: [1, 2]))])
+
+        let list = try #require(try loadPromptCacheSnapshot(url: url).cache.first as? CacheList)
+        let tokens = try #require(list.children.last as? TokenListCache)
+        #expect(tokens.tokens == [1, 2])
+    }
+
+    @Test func `saving registers the type so the same process can load it`() throws {
+        let url = Self.temporaryURL()
+        defer { try? FileManager.default.removeItem(at: url) }
+        try savePromptCache(url: url, cache: [SavedOnlyCache()])
+
+        #expect(try loadPromptCacheSnapshot(url: url).cache.first is SavedOnlyCache)
+    }
+
+    @Test func `registering the same type twice is allowed`() throws {
+        try registerKVCacheType(TokenListCache.self)
+        try registerKVCacheType(TokenListCache.self)
+    }
+
+    @Test func `another type cannot take a registered name`() throws {
+        try registerKVCacheType(TokenListCache.self)
+        #expect(throws: (any Error).self) {
+            try registerKVCacheType(OtherTokenListCache.self)
+        }
+
+        let url = Self.temporaryURL()
+        defer { try? FileManager.default.removeItem(at: url) }
+        #expect(throws: (any Error).self) {
+            try savePromptCache(url: url, cache: [OtherTokenListCache()])
+        }
+    }
+
+    @Test func `built-in names and aliases are taken`() {
+        #expect(throws: (any Error).self) {
+            try registerKVCacheType(BuiltInNameCache.self)
+        }
+        #expect(throws: (any Error).self) {
+            try registerKVCacheType(InheritedNameCache.self)
+        }
+    }
+
+    @Test func `a cache without a serialized class name cannot be saved`() {
+        let url = Self.temporaryURL()
+        defer { try? FileManager.default.removeItem(at: url) }
+        #expect(throws: (any Error).self) {
+            try savePromptCache(url: url, cache: [UnnamedCache()])
+        }
+        #expect(throws: (any Error).self) {
+            try savePromptCache(url: url, cache: [CacheList(KVCacheSimple(), UnnamedCache())])
+        }
+    }
+
+    @Test func `a subclass that keeps its parent's name restores as the parent`() throws {
+        let url = Self.temporaryURL()
+        defer { try? FileManager.default.removeItem(at: url) }
+        try savePromptCache(url: url, cache: [InheritedNameCache()])
+
+        let restored = try #require(try loadPromptCacheSnapshot(url: url).cache.first)
+        #expect(type(of: restored) == KVCacheSimple.self)
+    }
+}
diff --git a/Tests/MLXLMTests/ScriptedLM/TranscriptKVCacheTests.swift b/Tests/MLXLMTests/ScriptedLM/TranscriptKVCacheTests.swift
new file mode 100644
index 0000000..2e153eb
--- /dev/null
+++ b/Tests/MLXLMTests/ScriptedLM/TranscriptKVCacheTests.swift
@@ -0,0 +1,133 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLX
+import MLXLMCommon
+import MLXScriptedLM
+import Testing
+
+/// A custom cache without ``AuxiliaryKVCache``: cache policy treats it as an attention layer.
+private final class PlainCustomCache: BaseKVCache {
+    override var isTrimmable: Bool { true }
+    override func copy() -> any KVCache { PlainCustomCache() }
+}
+
+struct TranscriptKVCacheTests {
+
+    static func attention(_ count: Int) -> KVCacheSimple {
+        let cache = KVCacheSimple()
+        let entry = MLXArray.zeros([1, 2, count, 64])
+        _ = cache.update(keys: entry, values: entry)
+        return cache
+    }
+
+    @Test func `tokens follow append, trim, and copy`() throws {
+        let transcript = TranscriptKVCache(tokens: [1, 2])
+        transcript.append([3, 4, 5])
+        #expect(transcript.tokens == [1, 2, 3, 4, 5])
+        #expect(transcript.offset == 5)
+
+        #expect(transcript.trim(2) == 2)
+        #expect(transcript.tokens == [1, 2, 3])
+        #expect(transcript.trim(10) == 3)
+        #expect(transcript.offset == 0)
+
+        transcript.append([9])
+        let copy = try #require(transcript.copy() as? TranscriptKVCache)
+        transcript.append([10])
+        #expect(copy.tokens == [9])
+    }
+
+    @Test func `capacity validation skips the transcript`() throws {
+        let parameters = GenerateParameters(maxKVSize: 16)
+        let plan = try parameters.kvCachePlan()
+        let attention = try makeAttentionKVCache(parameters: parameters)
+
+        _ = try plan.validated([attention, TranscriptKVCache()])
+        #expect(throws: (any Error).self) {
+            _ = try plan.validated([attention, PlainCustomCache()])
+        }
+    }
+
+    @Test func `compression leaves the transcript untouched`() {
+        let transcript = TranscriptKVCache(tokens: Array(0 ..< 8))
+        var cache: [KVCache] = [Self.attention(8), transcript]
+
+        maybeQuantizeKVCache(cache: &cache, kvBits: 4, quantizedKVStart: 0)
+
+        #expect(cache[0] is QuantizedKVCache)
+        #expect((cache[1] as? TranscriptKVCache) === transcript)
+        #expect(transcript.tokens == Array(0 ..< 8))
+    }
+
+    @Test func `status reports and the shared timeline skip the transcript`() {
+        // Offsets disagree on purpose: the timeline must come from the attention entry.
+        let cache: [KVCache] = [Self.attention(5), TranscriptKVCache(tokens: [1, 2, 3])]
+
+        let status = KVCacheStatus(cache: cache, plan: .disabled, phase: .planned)
+        #expect(status.layers.count == 1)
+
+        let storage = KVCacheStorage(cache, plan: .disabled)
+        #expect(storage.processedTokenCount == 5)
+        #expect(storage.nativeAttentionOffsetsAreAligned)
+    }
+
+    @Test func `trimming and copying include the transcript`() throws {
+        let transcript = TranscriptKVCache(tokens: [1, 2, 3, 4, 5])
+        let storage = KVCacheStorage([Self.attention(5), transcript], plan: .disabled)
+
+        #expect(storage.trim(2) == 2)
+        #expect(storage.cache[0].offset == 3)
+        #expect(transcript.tokens == [1, 2, 3])
+
+        let copy = try #require(storage.copy().cache[1] as? TranscriptKVCache)
+        #expect(copy !== transcript)
+        #expect(copy.tokens == [1, 2, 3])
+    }
+
+    @Test func `a staged speculative round writes through and trims the transcript back`() throws {
+        let attention = Self.attention(3)
+        let transcript = TranscriptKVCache(tokens: [1, 2, 3])
+        let storage = KVCacheStorage([attention, transcript], plan: .disabled)
+
+        let round = try #require(storage.beginRound(maximumPositions: 4))
+        let presented = try #require(round.caches[1] as? TranscriptKVCache)
+        #expect(presented === transcript)
+
+        // The verify pass writes 4 positions to every entry; 2 are accepted.
+        let entry = MLXArray.zeros([1, 2, 4, 64])
+        _ = round.caches[0].update(keys: entry, values: entry)
+        presented.append([4, 5, 6, 7])
+        let commit = storage.commit(round, retaining: 2)
+
+        #expect(commit.committedPositions == 2)
+        #expect(attention.offset == 5)
+        #expect(transcript.tokens == [1, 2, 3, 4, 5])
+        #expect(storage.processedTokenCount == 5)
+    }
+
+    @Test func `a transcript round-trips through a prompt cache file`() throws {
+        let url = FileManager.default.temporaryDirectory
+            .appending(component: "transcript-\(UUID().uuidString).safetensors")
+        defer { try? FileManager.default.removeItem(at: url) }
+
+        try savePromptCache(
+            url: url, cache: [Self.attention(3), TranscriptKVCache(tokens: [4, 5, 6])])
+        let restored = try loadPromptCacheSnapshot(url: url).cache
+
+        #expect(restored[0].offset == 3)
+        let transcript = try #require(restored[1] as? TranscriptKVCache)
+        #expect(transcript.tokens == [4, 5, 6])
+    }
+
+    @Test func `an empty transcript round-trips`() throws {
+        let url = FileManager.default.temporaryDirectory
+            .appending(component: "transcript-\(UUID().uuidString).safetensors")
+        defer { try? FileManager.default.removeItem(at: url) }
+
+        try savePromptCache(url: url, cache: [KVCacheSimple(), TranscriptKVCache()])
+        let transcript = try #require(
+            try loadPromptCacheSnapshot(url: url).cache.last as? TranscriptKVCache)
+        #expect(transcript.tokens.isEmpty)
+    }
+}

commit 8ec6a2c62172bc61eb7ddd6111c1610aa03a42b3
Author: Alessio Pollero <alessio.pollero@gmail.com>
Date:   Thu Oct 15 20:46:23 2026 +0400

    Omit empty text from message content parts (#699)
    
    * Omit empty text from message content parts
    
    `contentParts(for:layout:)` always appended a text part, so an assistant
    tool call without text became `[{"type": "text", "text": ""}]`. Chat
    templates test `message.content` for truth: the empty string a text
    model receives is false, but a list holding an empty part is true.
    
    Qwen3-VL's template then renders the call as `\n\n<tool_call>` instead
    of the `\n<tool_call>` the model generated. The cache no longer matches
    the prompt, and a rewind is refused because the model carries M-RoPE
    state, so every tool follow-up pass prefilled the whole conversation.
    
    Empty text now gives no part. An empty list is false, as the empty
    string is, so the re-rendered prompt extends the cache again.
    
    Checked against the chat templates of every registered model that uses
    content parts (Qwen2-VL, Qwen2.5-VL, Qwen3-VL, Qwen3.5, Qwen3.8,
    Muse-Glimmer, Gemma 3, Gemma 4, LFM2-VL, Ministral 3, FastVLM, GLM-OCR):
    only the Qwen3-VL template changes output, and it now renders the same
    as with string content.
    
    * Limit empty text omission to assistant tool calls

