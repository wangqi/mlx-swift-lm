+        XCTAssertEqual(shared.model, before.model)
+        XCTAssertLessThan(shared.total, after.total)
+        XCTAssertEqual(
+            shared.model + shared.components.reduce(0) { $0 + $1.bytes },
+            shared.total)
+    }
