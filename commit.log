+/*!
+ *  Copyright (c) 2024 by Contributors
+ * \file xgrammar/grammar_parser.cc
+ */
+
+#include "grammar_parser.h"
+
+#include <picojson.h>
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <variant>
+#include <vector>
+
+#include "grammar_builder.h"
+#include "grammar_impl.h"
+#include "support/encoding.h"
