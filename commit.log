-                        weightFileSelection: weightFileSelection,
-                        excludedComponents: excludedComponents,
-                        componentLoading: componentLoading)
+                    try withLoaderThreadError {
+                        try loadWeights(
+                            modelDirectory: modelDirectory, model: model.consume(),
