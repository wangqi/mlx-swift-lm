+++/// Extract sliding local blocks from a batched input tensor.
+++/// Equivalent to PyTorch's nn.functional.unfold / im2col operation.
+++private func unfold(
+++    _ input: MLXArray,
+++    kernelSize: Int,
+++    dilation: Int = 1,
+++    padding: Int = 0,
+++    stride: Int = 1
+++) -> MLXArray {
+++    var x = input
+++    let (batchSize, channels, height, width) = (x.dim(0), x.dim(1), x.dim(2), x.dim(3))
+ +
+-+        super.init()
+++    // Add padding if needed
+++    if padding > 0 {
+++        x = MLX.padded(
+++            x,
+++            widths: [
+++                0,  // batch
+++                0,  // channels
+++                .init((padding, padding)),  // height
+++                .init((padding, padding)),  // width
+++            ])
+ +    }
+ +
+-+    func callAsFunction(_ x: MLXArray) -> MLXArray {
+-+        // Get routing scores
+-+        let gates = router(x)
+++    let paddedH = height + 2 * padding
+++    let paddedW = width + 2 * padding
+ +
+-+        var scores: MLXArray
+-+        if scoreFunc == "sigmoid" {
+-+            scores = sigmoid(gates.asType(.float32))
+-+        } else {
+-+            scores = softmax(gates.asType(.float32), axis: -1)
+-+        }
+++    // Calculate output dimensions
+++    let heightOut = (paddedH - dilation * (kernelSize - 1) - 1) / stride + 1
+++    let widthOut = (paddedW - dilation * (kernelSize - 1) - 1) / stride + 1
+ +
+-+        // Add expert bias for selection
+-+        var selectionScores = scores + expertBias
+++    // Extract blocks using array indexing
+++    var blocks: [MLXArray] = []
+ +
+-+        // Group-based expert selection if nGroup > 1
+-+        if nGroup > 1 {
+-+            selectionScores = unflatten(selectionScores, axis: -1, shape: [nGroup, -1])
+-+            let groupScores = sorted(selectionScores, axis: -1)[.ellipsis, ..<2].sum(
+-+                axis: -1, keepDims: true)
+-+            let k = nGroup - topkGroup
+-+            let groupIdx = argPartition(groupScores, kth: k - 1, axis: -2)[.ellipsis, ..<k, 0...]
+-+            selectionScores = putAlong(
+-+                selectionScores, stopGradient(groupIdx), values: MLXArray(0.0), axis: -2)
+-+            selectionScores = flattened(selectionScores, start: -2, end: -1)
+++    for i in Swift.stride(from: 0, to: paddedH - kernelSize * dilation + 1, by: stride) {
+++        for j in Swift.stride(from: 0, to: paddedW - kernelSize * dilation + 1, by: stride) {
+++            var block: [MLXArray] = []
+++            for di in 0 ..< kernelSize {
+++                for dj in 0 ..< kernelSize {
+++                    let hIdx = i + di * dilation
+++                    let wIdx = j + dj * dilation
+++                    block.append(x[0..., 0..., hIdx, wIdx])
+++                }
