+            <function=weather>
+            <parameter=city>
+            Paris
+            </parameter>
+            </function>
+            </tool_call>
+            """
+
+        for splitOffset in 0 ... payload.count {
+            let split = payload.index(payload.startIndex, offsetBy: splitOffset)
+            let processor = ToolCallProcessor(
