+    @Test("smart resize keeps the merged-token budget")
+    func smartResizeBudget() {
+        for (h, w) in [(4096, 4096), (8000, 200), (200, 8000), (3000, 2000)] {
+            let (rh, rw) = museSmartResize(height: h, width: w, factor: 28, maxTokens: 4096)
+            #expect(rh % 28 == 0)
+            #expect(rw % 28 == 0)
+            #expect((rh / 28) * (rw / 28) <= 4096)
+        }
+    }
