commit d7b94ee9a97b454619ab97de4c8966b5f84563ca
Author: Alessio Pollero <alessio.pollero@gmail.com>
Date:   Tue Nov 10 21:33:43 2026 +0400

    Add ModelTypeRegistry.contains(_:configuration:) for shared model types (#778)
    
    `contains(_:)` answers by name only, so it ignores the `matches`
    predicate that `registerModelType(_:matches:creator:)` adds for a
    `model_type` shared by several architectures. Once
    `LFM2DSparkRegistration` registers its drafter under "qwen3",
    `MTPDrafterTypeRegistry.shared.contains("qwen3")` is true for every
    Qwen3 checkpoint, and a caller cannot tell a DSpark drafter from a
    plain Qwen3 model before it loads one.
    
    The new overload asks whether `createModel(configuration:modelType:)`
    would find a creator that accepts the given configuration. It reads no
    weights and allocates no model. `contains(_:)` is unchanged.

diff --git a/Libraries/MLXLMCommon/Registries/ModelTypeRegistry.swift b/Libraries/MLXLMCommon/Registries/ModelTypeRegistry.swift
index 2570115..359837d 100644
--- a/Libraries/MLXLMCommon/Registries/ModelTypeRegistry.swift
+++ b/Libraries/MLXLMCommon/Registries/ModelTypeRegistry.swift
@@ -59,4 +59,12 @@ public actor ModelTypeRegistry<T> {
         creators[modelType] != nil
     }
 
+    /// Whether ``createModel(configuration:modelType:)`` would find a creator for
+    /// `modelType` that accepts `configuration`. Unlike ``contains(_:)``, this
+    /// honours the `matches` predicate of a shared `model_type`, so it answers
+    /// for one checkpoint rather than for every architecture with that name.
+    public func contains(_ modelType: String, configuration: Data) -> Bool {
+        creators[modelType]?.contains { $0.matches(configuration) } ?? false
+    }
+
 }
