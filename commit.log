commit ce3950e3f11e48a8ddf1a10a366dd911447363e0
Author: Sébastien BUREL <72229917+sebastien-burel@users.noreply.github.com>
Date:   Fri Oct 2 02:23:53 2026 +0200

    Drop MTP weights from converted Qwen 3.5 VLM checkpoints (#642)
    
    A converted checkpoint can keep its MTP head for speculative decoding.
    sanitize(weights:metadata:) returned MLX-format weights unchanged, so
    the mtp.* tensors reached the model and loading failed with unhandled
    keys. The MTP drafter loads them on its own.

diff --git a/Libraries/MLXVLM/Models/Qwen35.swift b/Libraries/MLXVLM/Models/Qwen35.swift
index e312130..9d54fe2 100644
--- a/Libraries/MLXVLM/Models/Qwen35.swift
+++ b/Libraries/MLXVLM/Models/Qwen35.swift
@@ -1409,7 +1409,8 @@ public class Qwen35: Module, VLMModel {
         MLXArray]
     {
         if metadata["format"]?.lowercased() == "mlx" {
-            return weights
+            // Converted checkpoints can keep the MTP head; the drafter loads it, not this model.
+            return weights.filter { !$0.key.contains("mtp.") }
         }
         return sanitize(weights: weights)
     }
