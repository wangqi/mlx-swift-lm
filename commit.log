@@ -286,12 +286,14 @@ enum TurboQuantMetalKernels {
                 if (pos_in_block < half_block) {
                     a = shared_buf[block_id * block_size + pos_in_block];
                     b = shared_buf[block_id * block_size + pos_in_block + half_block];
-                    shared_buf[d] = a + b;
