+        var completion: GenerateCompletionInfo?
+        for await event in stream {
+            if case .info(let info) = event { completion = info }
+        }
+        let tokens = await task.value
+        XCTAssertEqual(tokens, [42])
+        XCTAssertEqual(completion?.stopReason, .length)
