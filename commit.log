commit d5d8b290e601ac1bf11f24635f8f811a83b98bf8
Author: Alessio Pollero <alessio.pollero@gmail.com>
Date:   Fri Jul 31 19:13:29 2026 +0200

    Fix gated delta recurrence precision (#488)
    
    Use Kahan compensated summation for the recurrent k-state dot product so low-order terms do not drift at long context. Disable Metal reassociation and contraction only inside this reduction to preserve the algorithm under default fast math.
    
    Add an adversarial BF16-path regression that checks the FP32 recurrent state against the correctly rounded reference result.

diff --git a/Libraries/MLXLMCommon/GatedDelta.swift b/Libraries/MLXLMCommon/GatedDelta.swift
index 1cb74a0..39d012e 100644
--- a/Libraries/MLXLMCommon/GatedDelta.swift
+++ b/Libraries/MLXLMCommon/GatedDelta.swift
@@ -56,10 +56,20 @@ private func makeGatedDeltaKernel(hasMask: Bool) -> MLXFast.MLXFastKernel? {
             for (int t = 0; t < T; ++t) {
               if (\(maskSource)) {
                 float kv_mem = 0.0f;
-                for (int i = 0; i < n_per_t; ++i) {
-                  auto s_idx = n_per_t * dk_idx + i;
-                  state[i] = state[i] * g_[hv_idx];
-                  kv_mem += state[i] * k_[s_idx];
+                {
+                  // Preserve Kahan summation under Metal's default fast math.
+                  #pragma clang fp reassociate(off)
+                  #pragma clang fp contract(off)
+                  float kv_compensation = 0.0f;
+                  for (int i = 0; i < n_per_t; ++i) {
+                    auto s_idx = n_per_t * dk_idx + i;
+                    state[i] = state[i] * g_[hv_idx];
+                    auto product = state[i] * k_[s_idx];
+                    auto corrected = product - kv_compensation;
+                    auto next_sum = kv_mem + corrected;
+                    kv_compensation = (next_sum - kv_mem) - corrected;
+                    kv_mem = next_sum;
+                  }
                 }
                 kv_mem = simd_sum(kv_mem);
 
diff --git a/Tests/MLXLMTests/GatedDeltaTests.swift b/Tests/MLXLMTests/GatedDeltaTests.swift
index 407672b..8357107 100644
--- a/Tests/MLXLMTests/GatedDeltaTests.swift
+++ b/Tests/MLXLMTests/GatedDeltaTests.swift
@@ -122,4 +122,38 @@ public class GatedDeltaTests: XCTestCase {
         )
     }
 
+    /// The recurrent state update must retain low-order terms in its k-state dot product.
+    ///
+    /// Each SIMD lane accumulates one large value followed by five unit values. A naive
+    /// FP32 sum drops all five units, shifting the recurrent state by one ULP. Compensated
+    /// summation recovers them and matches the correctly rounded reference result.
+    func testGatedDeltaCompensatesRecurrentDotProduct() throws {
+        let keyDimension = 192
+        let laneState: [Float] = [100_000_000, 1, 1, 1, 1, 1]
+        let stateValues = (0 ..< 32).flatMap { _ in laneState }
+
+        let q = MLXArray.zeros([1, 1, 1, keyDimension], dtype: .bfloat16)
+        let k = MLXArray.ones([1, 1, 1, keyDimension], dtype: .bfloat16)
+        let v = MLXArray.zeros([1, 1, 1, 1], dtype: .bfloat16)
+        let a = MLXArray.zeros([1, 1, 1], dtype: .bfloat16)
+        let b = MLXArray.zeros([1, 1, 1], dtype: .bfloat16)
+        let aLog = MLXArray([-100] as [Float])
+        let dtBias = MLXArray.zeros([1], dtype: .bfloat16)
+        let state = MLXArray(stateValues).reshaped(1, 1, 1, keyDimension)
+
+        let (_, nextState) = gatedDeltaUpdate(
+            q: q, k: k, v: v, a: a, b: b,
+            aLog: aLog, dtBias: dtBias, state: state)
+
+        let actual = nextState[0, 0, 0, 0].item(Float.self)
+        let exactDotProduct = 32.0 * (100_000_000.0 + 5.0)
+        let expected = Float(100_000_000.0 - 0.5 * exactDotProduct)
+
+        XCTAssertEqual(
+            actual.bitPattern, expected.bitPattern,
+            "GDN recurrent dot product rounded to \(actual), expected \(expected). "
+                + "Naive FP32 accumulation loses the unit terms and returns -1.5e9."
+        )
+    }
+
 }

commit 510b891cb58df4655cc5a5f20fc6f3405f73850a
Author: GoodOlClint <goodolclint@gmail.com>
Date:   Fri Jul 31 11:44:02 2026 -0500

    Fix remaining Linux build breaks in MLXLMCommon and MLXGuidedGeneration (#483)
    
    Building the package on Linux (Swift 6.3.3, aarch64) currently fails in four
    places. Each was found while bringing the package up on a Linux/CUDA host and
    each is independent of the CUDA backend itself.
    
    1. `autoreleasepool` is unavailable without the Objective-C runtime. Six call
       sites use it: MLXLMCommon/Evaluate.swift (x4),
       MLXLMCommon/MTPSpeculativeTokenIterator.swift, and MLXLLM/LLMModel.swift.
       Adds a `#if !canImport(ObjectiveC)` shim alongside the existing Linux shims.
       It is `public` because that last caller is in a separate module, and its
       signature matches Foundation's so both `autoreleasepool { }` and
       `autoreleasepool(invoking:)` continue to resolve.
    
    2. MLXGuidedGeneration imported `os` unguarded. The existing `Logger` shim lives
       in MLXLMCommon and is `internal`, so it is not reachable from sibling
       modules. Adds a per-module copy, matching how the shim is already scoped, and
       drops the unguarded import. This is what the missing `warning` level below is
       actually needed for: `GuidedGenerationLoop.swift` logs at `.warning`.
    
    3. The Linux `Logger` shim declared only `info` and `error`. Both copies now
       declare the full `os.Logger` level set (`debug`, `notice`, `warning`,
       `fault`), so a call site added later does not reintroduce the break.
       MLXLMCommon itself only logs at `.info` today, so completing that copy is
       prophylactic; the MLXGuidedGeneration copy needs `warning` immediately.
    
    4. The MLXCXGrammar target linked `-lc++` unconditionally. Linux links libstdc++
       via the Swift toolchain and has no libc++ to link against. Guarded to Apple
       platforms, as the adjacent `-w` unsafeFlags line already is.
    
    All four are inert on Apple platforms: the shims sit behind `canImport` checks
    and the linker setting is now platform-scoped. Verified `swift build` is clean
    on macOS and that these four breaks no longer occur on Linux.
    
    MLXVLM remains un-ported on Linux (unguarded AVFoundation/CoreImage/CoreMedia
    across ~17 files) and is deliberately out of scope here.
    
    Co-authored-by: Claude Opus 5 <noreply@anthropic.com>

