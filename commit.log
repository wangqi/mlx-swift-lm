diff --git a/Libraries/MLXGuidedGeneration/XGrammarBridge.swift b/Libraries/MLXGuidedGeneration/XGrammarBridge.swift
index e82e667..3b10c39 100644
--- a/Libraries/MLXGuidedGeneration/XGrammarBridge.swift
+++ b/Libraries/MLXGuidedGeneration/XGrammarBridge.swift
@@ -733,6 +733,26 @@ public final class GrammarConstraint: @unchecked Sendable {
