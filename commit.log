+/*!
+ *  Copyright (c) 2025 by Contributors
+ * \file xgrammar/fsm_builder.cc
+ */
+#include "fsm_builder.h"
+
+#include <sys/types.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <optional>
+#include <set>
+#include <stack>
+#include <unordered_set>
+#include <utility>
