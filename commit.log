+++-+            try container.decodeIfPresent(Int.self, forKey: .maxPositionEmbeddings) ?? 131072
+++-+        self.rmsNormEps = try container.decodeIfPresent(Float.self, forKey: .rmsNormEps) ?? 1e-5
