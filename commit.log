+    func testConfigurationDecodingWithDefaults() throws {
+        // Minimal config - should use defaults for optional fields
+        let json = """
+            {
+                "vocab_size": 100,
+                "hidden_size": 64,
+                "num_hidden_layers": 2,
+                "num_attention_heads": 4,
