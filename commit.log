+++-+            try container.decodeIfPresent(Int.self, forKey: .numAttentionHeads) ?? 32
+++-+        self.numKeyValueHeads =
+++-+            try container.decodeIfPresent(Int.self, forKey: .numKeyValueHeads) ?? 4
