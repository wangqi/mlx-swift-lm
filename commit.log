++-+            // Insert image tokens
++-+            let imageTokens = Array(repeating: imageTokenId, count: numImageTokens)
++-+
++-+            var insertIndex = 0
++-+            if !promptTokens.isEmpty {
++-+                // If first token is BOS (typically id 1), insert after it
++-+                if promptTokens[0] == 1 {
