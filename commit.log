+package final class Gemma4RMSNormNoScale: Module, UnaryLayer {
+    let eps: Float
+
+    package init(eps: Float = 1e-6) {
+        self.eps = eps
+        super.init()
+    }
+
+    package func callAsFunction(_ x: MLXArray) -> MLXArray {
+        MLXFast.rmsNorm(x, weight: MLXArray.mlxNone, eps: eps)
+    }
+}
