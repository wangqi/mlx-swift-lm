+    /// One-indexed, `(width, height)` ordered. Both details are easy to drop and
+    /// would silently shift every rotary position.
+    @Test("position ids match the reference")
+    func positionIds() {
+        #expect(
+            musePositionIds([THW(1, 2, 3)]).asArray(Int.self) == [
+                1, 1, 2, 1, 3, 1, 1, 2, 2, 2, 3, 2,
+            ])
+        do {
+            let ids = musePositionIds([THW(1, 32, 32)]).asArray(Int.self)
+            #expect(ids.count == 2048)
+            #expect(Array(ids.prefix(8)) == [1, 1, 2, 1, 3, 1, 4, 1])
+            #expect(Array(ids.suffix(8)) == [29, 32, 30, 32, 31, 32, 32, 32])
+        }
+        do {
+            let ids = musePositionIds([THW(1, 64, 64)]).asArray(Int.self)
+            #expect(ids.count == 8192)
+            #expect(Array(ids.prefix(8)) == [1, 1, 2, 1, 3, 1, 4, 1])
+            #expect(Array(ids.suffix(8)) == [61, 64, 62, 64, 63, 64, 64, 64])
+        }
+        do {
+            let ids = musePositionIds([THW(1, 40, 24)]).asArray(Int.self)
+            #expect(ids.count == 1920)
+            #expect(Array(ids.prefix(8)) == [1, 1, 2, 1, 3, 1, 4, 1])
+            #expect(Array(ids.suffix(8)) == [21, 40, 22, 40, 23, 40, 24, 40])
+        }
+        #expect(
+            musePositionIds([THW(1, 4, 6), THW(1, 2, 2)]).asArray(Int.self) == [
+                1, 1, 2, 1, 3, 1, 4, 1, 5, 1, 6, 1, 1, 2, 2, 2, 3, 2, 4, 2, 5, 2, 6, 2, 1, 3, 2, 3,
+                3, 3, 4, 3, 5, 3, 6, 3, 1, 4, 2, 4, 3, 4, 4, 4, 5, 4, 6, 4, 1, 1, 2, 1, 1, 2, 2, 2,
+            ])
+    }
+
+    /// The channel axis precedes the two merge axes, so each merged vector is
+    /// channel-major. Compared on an integer ramp: a wrong permutation is a
+    /// mismatch, not a rounding difference.
+    @Test("2x2 patch merge is channel-major and matches the reference")
+    func pixelShuffle() {
+        do {
+            let ramp = MLXArray(0 ..< Int32(12)).reshaped(4, 3)
+            let merged = musePixelShuffle(ramp, grid: [THW(1, 2, 2)], mergeSize: 2)
+            #expect(merged.shape == [1, 12])
+            #expect(merged.asArray(Int.self) == [0, 3, 6, 9, 1, 4, 7, 10, 2, 5, 8, 11])
+        }
+        do {
+            let ramp = MLXArray(0 ..< Int32(72)).reshaped(24, 3)
+            let merged = musePixelShuffle(ramp, grid: [THW(1, 4, 6)], mergeSize: 2)
+            #expect(merged.shape == [6, 12])
+            #expect(
+                merged.asArray(Int.self) == [
+                    0, 3, 18, 21, 1, 4, 19, 22, 2, 5, 20, 23, 6, 9, 24, 27, 7, 10, 25, 28, 8, 11,
+                    26, 29, 12, 15, 30, 33, 13, 16, 31, 34, 14, 17, 32, 35, 36, 39, 54, 57, 37, 40,
+                    55, 58, 38, 41, 56, 59, 42, 45, 60, 63, 43, 46, 61, 64, 44, 47, 62, 65, 48, 51,
+                    66, 69, 49, 52, 67, 70, 50, 53, 68, 71,
+                ])
+        }
+        do {
+            let ramp = MLXArray(0 ..< Int32(40)).reshaped(20, 2)
+            let merged = musePixelShuffle(ramp, grid: [THW(1, 4, 4), THW(1, 2, 2)], mergeSize: 2)
+            #expect(merged.shape == [5, 8])
+            #expect(
+                merged.asArray(Int.self) == [
+                    0, 2, 8, 10, 1, 3, 9, 11, 4, 6, 12, 14, 5, 7, 13, 15, 16, 18, 24, 26, 17, 19,
+                    25, 27, 20, 22, 28, 30, 21, 23, 29, 31, 32, 34, 36, 38, 33, 35, 37, 39,
+                ])
+        }
+    }
+
+    /// Bilinear gather over the learned 32x32 table, including the half-pixel
+    /// convention and the validity masks that zero out-of-range corners.
+    @Test("interpolated position embeddings match the reference")
+    func positionEmbeddings() {
+        let side = 32
+        do {
+            let table =
+                (MLXArray(0 ..< Int32(4096)).asType(.float32)
+                / 1000.0).reshaped(side * side, 4)
+            let value = museInterpolatedPositionEmbeddings(
+                grid: [THW(1, 2, 3)], side: side
+            ) { table[$0] }
+            let expected: [Float] = [
+                0.979333401, 0.980333328, 0.981333375, 0.982333362, 1.02200007, 1.023, 1.02400005,
+                1.02499998, 1.06466663, 1.06566668, 1.0666666, 1.06766677, 3.02733326, 3.02833319,
+                3.02933335, 3.03033352, 3.06999993, 3.07099986, 3.07200003, 3.07299995, 3.11266685,
+                3.11366677, 3.11466646, 3.11566687,
+            ]
+            let actual = value.reshaped(-1).asArray(Float.self)
+            #expect(actual.count == expected.count)
+            for (a, e) in zip(actual, expected) { #expect(abs(a - e) < 1e-5) }
+        }
+    }
+}
