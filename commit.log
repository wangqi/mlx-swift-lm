diff --git a/Tests/MLXLMTests/Qwen35ContinuationTests.swift b/Tests/MLXLMTests/Qwen35ContinuationTests.swift
index 929a466..316829a 100644
--- a/Tests/MLXLMTests/Qwen35ContinuationTests.swift
+++ b/Tests/MLXLMTests/Qwen35ContinuationTests.swift
@@ -285,4 +285,95 @@ final class Qwen35ContinuationTests: XCTestCase {
     func testWindowedImagePrefillMatchesSingleShot() throws {
         try continuation.assertWindowedImagePrefill(try makeTinyModel())
     }
+
+    /// With a capacity-limited cache, the attention mask must span the keys
+    /// the cache still presents, not the absolute offset: eviction begins once
+    /// the prompt exceeds `maxTokens`, and a warm multi-token continuation is
+    /// the flow that then builds a mask. Asserted on the attention caches only
+    /// — the linear-attention layers keep recurrent Mamba caches.
+    func testWarmContinuationAfterCacheRotationMatchesDecode() throws {
+        for (capacity, suffixLength) in [(16, 6), (16, 1), (16, 23), (1, 6)] {
+            let model = try makeTinyModel()
+            let parameters = GenerateParameters(
+                kvCache: KVCacheConfiguration(
+                    capacity: try .init(maxTokens: capacity, preservedPrefixTokens: 0)))
+            let cache = try model.newCache(parameters: parameters)
+            let (_, initialState) = try lastLogits(
+                model.prepare(
+                    LMInput(text: .init(tokens: textTokens(capacity))), cache: cache, state: nil,
+                    prefill: .init(chunking: .unchunked)))
+            var state = initialState
+            let decoded = textTokens(5, seed: 3)
+            for index in 0 ..< decoded.dim(1) {
+                let output = model(
+                    .init(tokens: decoded[0..., index ..< index + 1]), cache: cache, state: state)
+                eval(output.logits)
+                state = output.state
+            }
+            let rotating = cache.compactMap { $0 as? RotatingKVCache }
+            XCTAssertFalse(rotating.isEmpty)
+            XCTAssertTrue(rotating.allSatisfy { $0.offset == capacity + 5 })
+
+            let referenceCache = cache.map { $0.copy() }
+            let suffix = textTokens(suffixLength, seed: 9)
+            var referenceState = state
+            var expected = [MLXArray]()
+            for index in 0 ..< suffix.dim(1) {
+                let output = model(
+                    .init(tokens: suffix[0..., index ..< index + 1]), cache: referenceCache,
+                    state: referenceState)
+                eval(output.logits)
+                expected.append(output.logits)
+                referenceState = output.state
+            }
+
+            let result = try model.prepare(
+                LMInput(text: .init(tokens: suffix)), cache: cache, state: state,
+                prefill: .init(chunking: .unchunked))
+            guard case .logits(let output) = result else {
+                return XCTFail("expected logits from warm continuation")
+            }
+            XCTAssertLessThanOrEqual(
+                maxAbsDiff(output.logits, concatenated(expected, axis: 1)),
+                MatmulPrecision.splitTolerance)
+            XCTAssertTrue(rotating.allSatisfy { $0.offset == capacity + 5 + suffixLength })
+        }
+    }
+
+    /// Windowed prefill past the cache capacity must agree with token-by-token
+    /// decode: each chunk's mask is cut to the retained window, so queries see
+    /// the same sliding context eviction gives the decode path.
+    func testWindowedPrefillBeyondCacheCapacityMatchesDecode() throws {
+        let model = try makeTinyModel()
+        let parameters = GenerateParameters(
+            kvCache: KVCacheConfiguration(
+                capacity: try .init(maxTokens: 16, preservedPrefixTokens: 0)))
+        let tokens = textTokens(40)
+        let referenceCache = try model.newCache(parameters: parameters)
+        let (_, initialState) = try lastLogits(
+            model.prepare(
+                LMInput(text: .init(tokens: tokens[0..., 0 ..< 1])), cache: referenceCache,
+                state: nil, prefill: .init()))
+        var state = initialState
+        var expected = MLXArray(0)
+        for index in 1 ..< tokens.dim(1) {
+            let output = model(
+                .init(tokens: tokens[0..., index ..< index + 1]), cache: referenceCache,
+                state: state)
+            expected = output.logits[0..., -1, 0...]
+            eval(expected)
+            state = output.state
+        }
+
+        let cache = try model.newCache(parameters: parameters)
+        let (actual, _) = try lastLogits(
+            model.prepare(
+                LMInput(text: .init(tokens: tokens)), cache: cache, state: nil,
+                prefill: .init(stepSize: 7)))
+        XCTAssertLessThanOrEqual(maxAbsDiff(actual, expected), MatmulPrecision.splitTolerance)
+        let rotating = cache.compactMap { $0 as? RotatingKVCache }
+        XCTAssertFalse(rotating.isEmpty)
+        XCTAssertTrue(rotating.allSatisfy { $0.offset == 40 })
+        XCTAssertEqual(rotating.first?.state.first?.dim(2), 16)
+    }
 }
diff --git a/Tests/MLXLMTests/Qwen3EmbedderMaskTests.swift b/Tests/MLXLMTests/Qwen3EmbedderMaskTests.swift
new file mode 100644
index 0000000..62f7220
--- /dev/null
+++ b/Tests/MLXLMTests/Qwen3EmbedderMaskTests.swift
@@ -0,0 +1,60 @@
+// Copyright © 2026 Apple Inc.
+//
+// The MLXEmbedders Qwen3 key-padding fold: real tokens must not attend to
+// padding keys, and the fold must line up with whatever key window the causal
+// mask is sized for.
+
+import Foundation
+import MLX
+import MLXLMCommon
+import XCTest
+
+@testable import MLXEmbedders
+
+final class Qwen3EmbedderMaskTests: XCTestCase {
+
+    private func makeTinyModel() throws -> Qwen3Model {
+        let json = """
+            {
+                "hidden_size": 32,
+                "num_hidden_layers": 2,
+                "intermediate_size": 64,
+                "num_attention_heads": 4,
+                "head_dim": 8,
+                "rms_norm_eps": 1e-5,
+                "vocab_size": 512,
+                "num_key_value_heads": 2,
+                "rope_theta": 10000.0
+            }
+            """
+        let config = try JSONDecoder().decode(Qwen3Configuration.self, from: Data(json.utf8))
+        // Pin the initializer weights. Task-local rather than MLXRandom.seed:
+        // parallel tests must not share (or perturb) the global random stream.
+        return withRandomState(MLXRandom.RandomState(seed: 1)) { Qwen3Model(config) }
+    }
+
+    /// Changing only a masked pad token must leave the real positions' hidden
+    /// states untouched; without the mask the pad key is visible and they move.
+    func testPaddingMaskHidesPaddedKeys() throws {
+        let model = try makeTinyModel()
+        var tokensB: [Int32] = [7, 11, 13, 17]
+        tokensB[0] = 23
+        let a = MLXArray([Int32(7), 11, 13, 17]).expandedDimensions(axis: 0)
+        let b = MLXArray(tokensB).expandedDimensions(axis: 0)
+        let padding = MLXArray([Int32(0), 1, 1, 1]).expandedDimensions(axis: 0)
+
+        let maskedA = model(a, attentionMask: padding).hiddenStates!
+        let maskedB = model(b, attentionMask: padding).hiddenStates!
+        eval(maskedA, maskedB)
+        XCTAssertLessThanOrEqual(
+            abs(maskedA[0..., 1..., 0...] - maskedB[0..., 1..., 0...]).max().item(Float.self),
+            1e-5)
+
+        let openA = model(a).hiddenStates!
+        let openB = model(b).hiddenStates!
+        eval(openA, openB)
+        XCTAssertGreaterThan(
+            abs(openA[0..., 1..., 0...] - openB[0..., 1..., 0...]).max().item(Float.self),
+            1e-3)
+    }
+}
diff --git a/Tests/MLXLMTests/Qwen3VLMoEContinuationTests.swift b/Tests/MLXLMTests/Qwen3VLMoEContinuationTests.swift
new file mode 100644
index 0000000..d7dab67
--- /dev/null
+++ b/Tests/MLXLMTests/Qwen3VLMoEContinuationTests.swift
@@ -0,0 +1,177 @@
+// Copyright © 2026 Apple Inc.
+//
+// Regression tests for Qwen3-VL-MoE attention masks after cache rotation.
+// Same bug class as Qwen3VLContinuationTests: once a capacity-limited cache
+// starts evicting, the mask must span the keys the cache still presents, not
+// the absolute offset. The model previously built its mask from the offset and
+// sliced it to an offset-derived length, so a warm multi-token continuation
+// described more keys than the cache retained and SDPA rejected the shapes.
+// M-RoPE positions stay absolute; only the mask width is under test.
+
+import Foundation
+import MLX
+import MLXLMCommon
+import MLXVLM
+import XCTest
+
+final class Qwen3VLMoEContinuationTests: XCTestCase {
+
+    // MARK: - Tiny model
+
+    private func makeTinyModel() throws -> Qwen3VLMoE {
+        let json = """
+            {
+                "model_type": "qwen3_vl_moe",
+                "image_token_id": 500,
+                "video_token_id": 501,
+                "vision_start_token_id": 502,
+                "vision_end_token_id": 503,
+                "vocab_size": 512,
+                "text_config": {
+                    "model_type": "qwen3_vl_moe",
+                    "hidden_size": 64,
+                    "num_hidden_layers": 4,
+                    "intermediate_size": 128,
+                    "num_attention_heads": 4,
+                    "num_key_value_heads": 2,
+                    "head_dim": 16,
+                    "vocab_size": 512,
+                    "max_position_embeddings": 4096,
+                    "rms_norm_eps": 1e-6,
+                    "rope_theta": 100000.0,
+                    "num_experts": 2,
+                    "num_experts_per_tok": 1,
+                    "decoder_sparse_step": 1,
+                    "mlp_only_layers": [],
+                    "moe_intermediate_size": 32,
+                    "rope_scaling": {
+                        "rope_type": "default",
+                        "mrope_section": [4, 2, 2]
+                    }
+                },
+                "vision_config": {
+                    "model_type": "qwen3_vl_moe",
+                    "depth": 2,
+                    "hidden_size": 32,
+                    "intermediate_size": 64,
+                    "out_hidden_size": 64,
+                    "num_heads": 2,
+                    "patch_size": 16,
+                    "spatial_merge_size": 2,
+                    "temporal_patch_size": 2,
+                    "num_position_embeddings": 64
+                }
+            }
+            """
+        let config = try JSONDecoder().decode(
+            Qwen3VLMoEConfiguration.self, from: Data(json.utf8))
+        // Pin the initializer weights. Task-local rather than MLXRandom.seed:
+        // parallel tests must not share (or perturb) the global random stream.
+        return withRandomState(MLXRandom.RandomState(seed: 1)) { Qwen3VLMoE(config) }
+    }
+
+    /// The shared continuation fixtures, configured for Qwen3-VL-MoE's token ids.
+    private let continuation = ContinuationAssertions(
+        imageTokenId: 500, visionStartTokenId: 502)
+
+    private func makeImage() -> LMInput.ProcessedImage { continuation.image() }
+
+    private func imageRun() -> MLXArray {
+        MLXArray([Int32](repeating: 500, count: 4)).expandedDimensions(axis: 0)
+    }
+
+    private func visionStart() -> MLXArray {
+        MLXArray([Int32(502)]).expandedDimensions(axis: 0)
+    }
+
+    private func textTokens(_ count: Int, seed: Int32 = 0) -> MLXArray {
+        continuation.textTokens(count, seed: seed)
+    }
+    private func lastLogits(_ result: PrepareResult) throws -> (MLXArray, LMOutput.State?) {
+        try continuation.lastLogits(result)
+    }
+    private func maxAbsDiff(_ a: MLXArray, _ b: MLXArray) -> Float {
+        continuation.maxAbsDiff(a, b)
+    }
+
+    // MARK: - Warm continuation
+
+    /// Prefill, decode, then continue warm on the rotated cache: the warm
+    /// multi-token forward must match token-by-token decode on a cache copy.
+    /// Before the mask fix this trapped: the mask described more keys than the
+    /// cache retained.
+    func testWarmContinuationAfterCacheRotationMatchesDecode() throws {
+        for (capacity, suffixLength) in [(16, 6), (16, 1), (16, 23), (1, 6)] {
+            let model = try makeTinyModel()
+            let parameters = GenerateParameters(
+                kvCache: KVCacheConfiguration(
+                    capacity: try .init(maxTokens: capacity, preservedPrefixTokens: 0)))
+            let cache = try model.newCache(parameters: parameters)
+            let (_, initialState) = try lastLogits(
+                model.prepare(
+                    LMInput(text: .init(tokens: textTokens(capacity))), cache: cache, state: nil,
+                    prefill: .init(chunking: .unchunked)))
+            var state = initialState
+            let decoded = textTokens(5, seed: 3)
+            for index in 0 ..< decoded.dim(1) {
+                let output = model(
+                    .init(tokens: decoded[0..., index ..< index + 1]), cache: cache, state: state)
+                eval(output.logits)
+                state = output.state
+            }
+            XCTAssertTrue(cache.allSatisfy { $0.offset == capacity + 5 })
+
+            let referenceCache = cache.map { $0.copy() }
+            let suffix = textTokens(suffixLength, seed: 9)
+            var referenceState = state
+            var expected = [MLXArray]()
+            for index in 0 ..< suffix.dim(1) {
+                let output = model(
+                    .init(tokens: suffix[0..., index ..< index + 1]), cache: referenceCache,
+                    state: referenceState)
+                eval(output.logits)
+                expected.append(output.logits)
+                referenceState = output.state
+            }
+
+            let result = try model.prepare(
+                LMInput(text: .init(tokens: suffix)), cache: cache, state: state,
+                prefill: .init(chunking: .unchunked))
+            guard case .logits(let output) = result else {
+                return XCTFail("expected logits from warm continuation")
+            }
+            XCTAssertLessThanOrEqual(
+                maxAbsDiff(output.logits, concatenated(expected, axis: 1)),
+                MatmulPrecision.splitTolerance)
+            XCTAssertTrue(cache.allSatisfy { $0.offset == capacity + 5 + suffixLength })
+        }
+    }
+
+    /// The image path supplies M-RoPE position ids, the branch that also
+    /// derived the mask width from the offset. A warm text continuation after
+    /// an image turn must survive eviction and stay finite.
+    func testImageContinuationAfterCacheRotationWithPreservedCachePrefix() throws {
+        try withRandomState(MLXRandom.RandomState(seed: 47)) {
+            let model = try makeTinyModel()
+            let parameters = GenerateParameters(
+                kvCache: KVCacheConfiguration(
+                    capacity: try .init(maxTokens: 16, preservedPrefixTokens: 4)))
+            let cache = try model.newCache(parameters: parameters)
+            let prompt = concatenated(
+                [textTokens(6), visionStart(), imageRun(), textTokens(12, seed: 2)], axis: 1)
+            let (initialLogits, state) = try lastLogits(
+                model.prepare(
+                    LMInput(text: .init(tokens: prompt), image: makeImage()), cache: cache,
+                    state: nil, prefill: .init()))
+            eval(initialLogits)
+            XCTAssertEqual(cache.first?.offset, 23)
+
+            let (logits, _) = try lastLogits(
+                model.prepare(
+                    LMInput(text: .init(tokens: textTokens(9, seed: 5))), cache: cache,
+                    state: state, prefill: .init()))
+            XCTAssertTrue(logits.asArray(Float.self).allSatisfy(\.isFinite))
+            XCTAssertEqual(cache.first?.offset, 32)
+        }
+    }
+}

commit c3d3afe47dbbe437c7ba8dc7202b22acf00e6d7a
Author: Ronald Mannak <ronaldmannak@me.com>
Date:   Wed Oct 28 14:12:28 2026 -0700

    FastVLM: Keep image sentinels out of the repetition-penalty history (#735)
    
    Keep image sentinels out of the repetition-penalty history
    
    VLM prompts carry negative placeholder IDs (FastVLM uses -200). The
    penalty processors loaded them into their token history and then
    indexed logits with them. loadPrompt now drops negative IDs, so
    sampled tokens are unaffected.
    
    To keep loading cheap on long prompts, it reads the prompt back to
    front, starting with `capacity` tokens and then doubling the window
    size, until it has `capacity` tokens. Each window is converted on the
    CPU stream to skip a GPU round trip. Loading no longer scales with
    prompt length (0.01 to 0.04 ms, down from about 2 ms per processor
    for a 1M-token prompt).
    
    Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/Libraries/MLXLMCommon/Evaluate.swift b/Libraries/MLXLMCommon/Evaluate.swift
index f967f9b..97b117c 100644
--- a/Libraries/MLXLMCommon/Evaluate.swift
+++ b/Libraries/MLXLMCommon/Evaluate.swift
@@ -532,23 +532,27 @@ struct TokenRing {
     }
 
     /// Bulk-load from a prompt. Keeps the last `capacity` tokens.
+    ///
+    /// Image sentinels (such as FastVLM's -200) are not vocabulary IDs, so they are
+    /// skipped. The prompt is read back to front, only as far as it takes to find
+    /// `capacity` tokens.
     mutating func loadPrompt(_ prompt: MLXArray) {
-        let promptTokens = prompt.asType(.int32).flattened()
-        let n = promptTokens.count
-        if n <= capacity {
-            if n < capacity {
-                let padding = MLXArray.zeros([capacity - n], type: Int32.self)
-                buffer = concatenated([promptTokens, padding])
-            } else {
-                buffer = promptTokens
-            }
-            count = n
-            writeIndex = n % capacity
-        } else {
-            buffer = promptTokens[(-capacity)...]
-            count = capacity
-            writeIndex = 0
-        }
+        let prompt = prompt.flattened()
+        var tokens = [Int32]()
+        var end = prompt.size
+        var length = capacity
+        while tokens.count < capacity, end > 0 {
+            let start = max(0, end - length)
+            // Converting on the CPU skips a GPU round trip for a handful of tokens.
+            let chunk = prompt[start ..< end].asType(.int32, stream: .cpu)
+            tokens = chunk.asArray(Int32.self).filter { $0 >= 0 } + tokens
+            end = start
+            length *= 2
+        }
+        let kept = tokens.suffix(capacity)
+        buffer = MLXArray(Array(kept) + [Int32](repeating: 0, count: capacity - kept.count))
+        count = kept.count
+        writeIndex = count % capacity
     }
 
     /// Append a single token using GPU-only mask write (no CPU←GPU sync).

commit c358ceac06507a63f318b68ef904e590edb703eb
Author: Krish Garg <krishg.4740@gmail.com>
Date:   Wed Oct 28 13:56:19 2026 -0700

    Throw when Bert id2label keys share an integer id (#736)
    
    BertConfiguration turned each id2label string key into an Int and built
    the dictionary with uniqueKeysWithValues. Keys such as "1" and "01" both
    become 1, and Dictionary(uniqueKeysWithValues:) traps.
    
    Read the keys one at a time. Skip a key that is not an integer. Throw
    DecodingError.dataCorrupted when an integer id is already in the map.
    A test covers colliding keys and a normal id2label.
    
    Co-authored-by: Krish Garg <181051779+krishhgg@users.noreply.github.com>

