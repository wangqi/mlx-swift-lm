diff --git a/Libraries/MLXScriptedLM/Model/TurnScripts.swift b/Libraries/MLXScriptedLM/Model/TurnScripts.swift
new file mode 100644
index 0000000..c287839
--- /dev/null
+++ b/Libraries/MLXScriptedLM/Model/TurnScripts.swift
@@ -0,0 +1,145 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+
+/// The tokens a scripted model emits on each assistant turn, and how it finds the turn.
+///
+/// A turn starts after each occurrence of ``turnMarker`` (the template's generation
+/// prompt, such as `<|assistant|>`). Within a turn the script is indexed by position, not
+/// content: the token after position `start + k` is `script[k + 1]`, whatever the input.
+/// So a wrong speculative draft does not move the cursor, and a model with a different
+/// script (a draft model) keeps following its own.
+///
+/// Each new turn is the one after the previous turn, unless the prompt ends with one of
+/// ``promptEndings``. `ChatSession` drops an empty, cancelled, or rejected turn together
+/// with the user message before it, so order alone would replay the dropped turn's script.
+/// When several turns match, the first one at or after the next turn wins, otherwise the
+/// last one.
+///
+/// A turn past the last script emits ``endOfSequence`` (or a stop token), so an extra turn
+/// ends at once with an empty reply instead of running to `maxTokens`.
+///
+/// A marker inside the current turn starts a new turn, unless the script itself has the
+/// marker at that position. That handles history that renders a turn shorter than its
+/// script (reasoning stripped, for example) and scripts that contain the marker.
+public struct TurnScripts: Sendable, Equatable {
+
+    /// Where the next token comes from: `scripts[turn][index]`. An `index` equal to the
+    /// script's length means the script is used up.
+    public struct Cursor: Sendable, Equatable {
+        public let turn: Int
+        public let index: Int
+
+        public init(turn: Int, index: Int) {
+            self.turn = turn
+            self.index = index
+        }
+    }
+
+    /// The tokens each assistant turn emits, in order.
+    public let scripts: [[Int]]
+
+    /// The tokens that open an assistant turn.
+    public let turnMarker: [Int]
+
+    /// For each script, the tokens that end its prompt (the user message and the
+    /// generation prompt), or `nil` to place the turn by order alone.
+    public let promptEndings: [[Int]?]
+
+    /// The end-of-sequence token. A turn whose script ends with it, or with a stop token, is
+    /// over after the script.
+    public let endOfSequence: Int?
+
+    /// Other token ids that stop generation, such as a model configuration's `eosTokenIds`.
+    public let stopTokens: Set<Int>
+
+    /// Tokens the model must not emit inside a turn where the script has no token: the stop
+    /// tokens and the first marker token. Either one would end the turn early or start the
+    /// next one. Stop strings are not covered.
+    public var blockedUnscriptedTokens: Set<Int> {
+        stopTokens.union([turnMarker[0], endOfSequence].compactMap { $0 })
+    }
+
+    public init(
+        scripts: [[Int]], turnMarker: [Int], promptEndings: [[Int]?]? = nil,
+        endOfSequence: Int? = nil, stopTokens: Set<Int> = []
+    ) {
+        precondition(!turnMarker.isEmpty, "turnMarker must not be empty")
+        let promptEndings = promptEndings ?? Array(repeating: nil, count: scripts.count)
+        precondition(
+            promptEndings.count == scripts.count, "promptEndings needs one entry per script")
+        self.scripts = scripts
+        self.turnMarker = turnMarker
+        self.promptEndings = promptEndings
+        self.endOfSequence = endOfSequence
+        self.stopTokens = stopTokens
+    }
+
+    /// The scripted token at `cursor`, or `nil` when the turn has no script or it is used up.
+    public func token(at cursor: Cursor) -> Int? {
+        let script = script(for: cursor.turn)
+        return script.indices.contains(cursor.index) ? script[cursor.index] : nil
+    }
+
+    /// The turn's script, or a single stop token for a turn past the last script.
+    private func script(for turn: Int) -> [Int] {
+        if scripts.indices.contains(turn) { return scripts[turn] }
+        guard turn >= 0, let stop = endOfSequence ?? stopTokens.min() else { return [] }
+        return [stop]
+    }
+
+    /// For each position in `tokens`, the cursor for the token that follows it, or `nil`
+    /// outside an assistant turn.
+    public func cursors(for tokens: [Int]) -> [Cursor?] {
+        var result = [Cursor?](repeating: nil, count: tokens.count)
+        var turn = -1
+        var start: Int?
+        var i = 0
+
+        while i < tokens.count {
+            let script = script(for: turn)
+
+            // The script position of token i, while inside a scripted turn.
+            var k: Int?
+            if let start, i - start < script.count {
+                k = i - start
+            }
+
+            let markerIsScripted = k.map { hasMarker(in: script, at: $0) } ?? false
+            if hasMarker(in: tokens, at: i), !markerIsScripted {
+                let end = i + turnMarker.count
+                turn = nextTurn(after: turn, prompt: tokens[..<end])
+                result[end - 1] = Cursor(turn: turn, index: 0)
+                start = end
+                i = end
+                continue
+            }
+
+            if let k {
+                result[i] = Cursor(turn: turn, index: k + 1)
+            } else if start != nil {
+                if let last = script.last, last == endOfSequence || stopTokens.contains(last) {
+                    start = nil
+                } else {
+                    // Unscripted tokens after the script, until the next marker.
+                    result[i] = Cursor(turn: turn, index: script.count)
+                }
+            }
+            i += 1
+        }
+        return result
+    }
+
+    private func nextTurn(after turn: Int, prompt: ArraySlice<Int>) -> Int {
+        let matches = promptEndings.indices.filter { index in
+            guard let ending = promptEndings[index] else { return false }
+            return prompt.count >= ending.count && prompt.suffix(ending.count).elementsEqual(ending)
+        }
+        return matches.first { $0 > turn } ?? matches.last ?? turn + 1
+    }
+
+    private func hasMarker(in tokens: [Int], at index: Int) -> Bool {
+        guard index >= 0, index + turnMarker.count <= tokens.count else { return false }
+        return tokens[index ..< index + turnMarker.count].elementsEqual(turnMarker)
+    }
+}
diff --git a/Libraries/MLXScriptedLM/README.md b/Libraries/MLXScriptedLM/README.md
index 99a8c95..4b1f3f7 100644
--- a/Libraries/MLXScriptedLM/README.md
+++ b/Libraries/MLXScriptedLM/README.md
@@ -15,11 +15,10 @@ It is available as a library so that downstream consumers
 can make use of it as well.
 
 Status: Tokenizers are built and integrated into the local tests.
+Scripted models follow plain-text transcripts.
 
-Planned: Scripted LanguageModels that wrap real (random weight) models.
-This will allow you to construct tests that have real model behavior in
-terms of KVCache, but require no weight downloads.  Scripted tool
-integration is also planned.
+Planned: tool calls and reasoning in transcripts, and speculative
+decoding scenarios.
 
 ## Pieces
 
@@ -44,6 +43,33 @@ integration is also planned.
 - `ChatMLTemplate` — plain ChatML (`<|im_start|>user\n` … `<|im_end|>`). Tools
   and tool calls throw `unsupported` until family variants arrive.
 
+### Scripted Models
+
+- `Transcript` — the conversation: system, user, and assistant turns. Write
+  it as an array or load it from JSON. Each assistant turn ends with EOS
+  unless its terminator is `none`.
+- `ScriptedLogitsModel` — wraps a small random-weight model and raises the
+  scripted token above each logits row's maximum. The wrapped model does the
+  real cache and prefill work, and samplers still see a full distribution.
+  `Margin.dominant` keeps the script under any sampler; `.plausible` lets
+  processors override it.
+- `TurnScripts` — finds the turn and position. Each assistant turn starts
+  after the template's generation prompt, and the script is indexed by
+  position from there. The prompt's last user message picks the turn, so a
+  turn that `ChatSession` drops (empty, cancelled) does not replay. After the
+  script, stop tokens and the turn marker are blocked until the turn ends. A
+  turn past the end of the transcript emits EOS at once.
+- `TranscriptKVCache` — the tokens the model has processed, kept as the last
+  cache entry. Generation trims and copies it with the rest of the cache, so
+  the position stays right after rewinds and speculative rejection.
+- `ForwardCallLog` — every call: cache offset, inputs, boosted tokens, and
+  any input that differed from the script.
+- `ForwardingLanguageModel` — forwards every `LanguageModel` requirement, for
+  wrappers that change one behavior. Its parameters are the wrapped model's,
+  under the same keys, so weights load and quantize through it.
+- `ScriptedScenario` — builds the tokenizer, model, and `ModelContext` from a
+  transcript. You supply the wrapped model, sized to the vocabulary.
+
 ## Example
 
 ```swift
@@ -59,6 +85,19 @@ let prompt = try tokenizer.applyChatTemplate(
 let reply = tokenizer.encode(text: "fine, you?", addSpecialTokens: false)
 ```
 
+```swift
+@_spi(Testing) import MLXLLM
+
+let scenario = try ScriptedScenario(
+    transcript: Transcript([.user("hello"), .assistant("hi there")])
+) { vocabularySize in
+    // any small random-weight model with this vocabulary size
+    Gemma3TextModel(.smallConfiguration(vocabularySize: vocabularySize))
+}
+let session = ChatSession(scenario.context)
+let reply = try await session.respond(to: "hello")  // "hi there"
+```
+
 ## Implementation Notes
 
 - Words longer than `maxPieceLength` (default 4 bytes) are always multi-token.
diff --git a/Libraries/MLXScriptedLM/Scenario/ScriptedScenario.swift b/Libraries/MLXScriptedLM/Scenario/ScriptedScenario.swift
new file mode 100644
index 0000000..b87d9da
--- /dev/null
+++ b/Libraries/MLXScriptedLM/Scenario/ScriptedScenario.swift
@@ -0,0 +1,76 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLX
+import MLXLMCommon
+
+/// Renders chat input with a tokenizer's chat template.
+public struct ScriptedInputProcessor: UserInputProcessor {
+    public let tokenizer: any Tokenizer
+    public let messageGenerator: any MessageGenerator
+
+    public init(
+        tokenizer: any Tokenizer, messageGenerator: any MessageGenerator = DefaultMessageGenerator()
+    ) {
+        self.tokenizer = tokenizer
+        self.messageGenerator = messageGenerator
+    }
+
+    public func prepare(input: UserInput) throws -> LMInput {
+        let messages = messageGenerator.generate(from: input)
+        let tokens = try tokenizer.applyChatTemplate(
+            messages: messages, tools: input.tools, additionalContext: input.additionalContext)
+        return LMInput(tokens: MLXArray(tokens))
+    }
+}
+
+/// A transcript, a tokenizer built from it, and a model that follows it.
+///
+/// ```swift
+/// // @_spi(Testing) import MLXLLM
+/// let scenario = try ScriptedScenario(
+///     transcript: Transcript([.user("hello"), .assistant("hi there")])
+/// ) { vocabularySize in
+///     Gemma3TextModel(.smallConfiguration(vocabularySize: vocabularySize))
+/// }
+/// let session = ChatSession(scenario.context)
+/// let reply = try await session.respond(to: "hello")  // "hi there"
+/// ```
+public struct ScriptedScenario {
+    public let transcript: Transcript
+    public let tokenizer: ScriptedTokenizer
+    public let model: ScriptedLogitsModel
+    public let context: ModelContext
+
+    /// - Parameters:
+    ///   - transcript: the conversation to script.
+    ///   - template: the chat template; the generation prompt marks each assistant turn.
+    ///   - margin: how strongly the model favors the scripted token.
+    ///   - configuration: the context's model configuration. Its `eosTokenIds` and
+    ///     `extraEOSTokens` are blocked after a script, like the tokenizer's EOS.
+    ///   - innerModel: makes the wrapped model, given the vocabulary size it must support.
+    ///     Usually a small model with random weights.
+    public init(
+        transcript: Transcript,
+        template: any ScriptedChatTemplate = MinimalChatTemplate(),
+        margin: ScriptedLogitsModel.Margin = .dominant,
+        configuration: ModelConfiguration = ModelConfiguration(id: "scripted"),
+        innerModel: (_ vocabularySize: Int) throws -> any LanguageModel
+    ) throws {
+        let tokenizer = ScriptedTokenizer(transcript: transcript, template: template)
+        let model = ScriptedLogitsModel(
+            wrapping: try innerModel(tokenizer.vocabulary.size),
+            scripts: try TurnScripts(
+                transcript: transcript, tokenizer: tokenizer,
+                stopTokens: configuration.eosTokenIds.union(
+                    configuration.extraEOSTokens.compactMap(tokenizer.convertTokenToId))),
+            margin: margin)
+
+        self.transcript = transcript
+        self.tokenizer = tokenizer
+        self.model = model
+        self.context = ModelContext(
+            configuration: configuration, model: model,
+            processor: ScriptedInputProcessor(tokenizer: tokenizer), tokenizer: tokenizer)
+    }
+}
diff --git a/Libraries/MLXScriptedLM/Transcript/Transcript.swift b/Libraries/MLXScriptedLM/Transcript/Transcript.swift
new file mode 100644
index 0000000..9d52a3f
--- /dev/null
+++ b/Libraries/MLXScriptedLM/Transcript/Transcript.swift
@@ -0,0 +1,223 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLXLMCommon
+
+/// A conversation to script: what the user says and what the model replies.
+///
+/// Write it as an array in code, or load it from JSON:
+///
+/// ```json
+/// {
+///   "turns": [
+///     { "system": "Be brief." },
+///     { "user": "hello" },
+///     { "assistant": "hi there" },
+///     { "user": "count" },
+///     { "assistant": { "text": "one two three", "terminator": "none" } }
+///   ]
+/// }
+/// ```
+public struct Transcript: Sendable, Equatable, Codable {
+
+    public enum Turn: Sendable, Equatable {
+        case system(String)
+        case user(String)
+        case assistant(Assistant)
+    }
+
+    /// What ends an assistant turn's script.
+    public enum Terminator: String, Sendable, Equatable, Codable {
+        /// The tokenizer's EOS token, so generation stops on its own.
+        case endOfSequence = "eos"
+        /// Nothing: generation runs until `maxTokens`, emitting unscripted tokens after the
+        /// script. Those are never a stop token or the turn marker, so the turn cannot end
+        /// early. Stop strings can still match the decoded text.
+        case none
+    }
+
+    public struct Assistant: Sendable, Equatable, ExpressibleByStringLiteral {
+        public var text: String
+        public var terminator: Terminator
+
+        public init(_ text: String, terminator: Terminator = .endOfSequence) {
+            self.text = text
+            self.terminator = terminator
+        }
+
+        public init(stringLiteral value: String) {
+            self.init(value)
+        }
+    }
+
+    public var turns: [Turn]
+
+    public init(_ turns: [Turn]) {
+        self.turns = turns
+    }
+
+    public init(contentsOf url: URL) throws {
+        self = try JSONDecoder().decode(Transcript.self, from: Data(contentsOf: url))
+    }
+
+    public var assistantTurns: [Assistant] {
+        turns.compactMap {
+            if case .assistant(let assistant) = $0 { assistant } else { nil }
+        }
+    }
+
+    public var userMessages: [String] {
+        turns.compactMap {
+            if case .user(let text) = $0 { text } else { nil }
+        }
+    }
+
+    /// All the text in the transcript, for building a tokenizer's vocabulary.
+    public var corpus: [String] {
+        turns.map {
+            switch $0 {
+            case .system(let text), .user(let text): text
+            case .assistant(let assistant): assistant.text
+            }
+        }
+    }
+
+    /// The tokens each assistant turn emits: its text, then EOS if it has one.
+    public func scripts(tokenizer: any Tokenizer) -> [[Int]] {
+        assistantTurns.map { assistant in
+            var tokens = tokenizer.encode(text: assistant.text, addSpecialTokens: false)
+            if assistant.terminator == .endOfSequence {
+                guard let eos = tokenizer.eosToken.flatMap(tokenizer.convertTokenToId) else {
+                    preconditionFailure(
+                        "the transcript ends a turn with EOS but the tokenizer has none")
+                }
+                tokens.append(eos)
+            }
+            return tokens
+        }
+    }
+}
+
+// MARK: - Tokenizer and scripts
+
+extension ScriptedTokenizer {
+    /// Builds a tokenizer whose vocabulary covers the transcript's text.
+    public init(
+        transcript: Transcript,
+        template: any ScriptedChatTemplate = MinimalChatTemplate(),
+        specials: [String] = [],
+        textMarkers: [String] = [],
+        configuration: VocabularyBuilder.Configuration = .init()
+    ) {
+        self.init(
+            corpus: transcript.corpus, template: template, specials: specials,
+            textMarkers: textMarkers, configuration: configuration)
+    }
+}
+
+extension TurnScripts {
+
+    /// Initialize the TurnScripts.
+    ///
+    /// The transcript's assistant scripts, with the template's
+    /// generation prompt as the turn marker.
+    ///
+    /// An assistant turn that follows a user turn ends its prompt
+    /// with that user message, rendered alone. This assumes the
+    /// template renders a lone user message without a default
+    /// system prompt.
+    ///
+    /// - Parameters:
+    ///   - transcript: the transcript
+    ///   - tokenizer: the tokenizer
+    ///   - stopTokens: token ids that stop generation besides the
+    ///     tokenizer's EOS
+    public init(
+        transcript: Transcript, tokenizer: ScriptedTokenizer, stopTokens: Set<Int> = []
+    ) throws {
+        let marker = try tokenizer.applyChatTemplate(
+            messages: [], tools: nil, additionalContext: nil)
+
+        var endings: [[Int]?] = []
+        for (index, turn) in transcript.turns.enumerated() {
+            guard case .assistant = turn else { continue }
+            if index > 0, case .user(let text) = transcript.turns[index - 1] {
+                endings.append(
+                    try tokenizer.applyChatTemplate(
+                        messages: [["role": "user", "content": text]], tools: nil,
+                        additionalContext: nil))
+            } else {
+                endings.append(nil)
+            }
+        }
+
+        self.init(
+            scripts: transcript.scripts(tokenizer: tokenizer), turnMarker: marker,
+            promptEndings: endings,
+            endOfSequence: tokenizer.eosTokenId, stopTokens: stopTokens)
+    }
+}
+
+// MARK: - Codable
+
+extension Transcript.Turn: Codable {
+    private enum CodingKeys: String, CodingKey {
+        case system, user, assistant
+    }
+
+    public init(from decoder: any Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        guard container.allKeys.count == 1, let key = container.allKeys.first else {
+            throw DecodingError.dataCorrupted(
+                .init(
+                    codingPath: container.codingPath,
+                    debugDescription: "A turn needs exactly one of system, user, or assistant"))
+        }
+        switch key {
+        case .system: self = .system(try container.decode(String.self, forKey: key))
+        case .user: self = .user(try container.decode(String.self, forKey: key))
+        case .assistant:
+            self = .assistant(try container.decode(Transcript.Assistant.self, forKey: key))
+        }
+    }
+
+    public func encode(to encoder: any Encoder) throws {
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        switch self {
+        case .system(let text): try container.encode(text, forKey: .system)
+        case .user(let text): try container.encode(text, forKey: .user)
+        case .assistant(let assistant): try container.encode(assistant, forKey: .assistant)
+        }
+    }
+}
+
+extension Transcript.Assistant: Codable {
+    private enum CodingKeys: String, CodingKey {
+        case text, terminator
+    }
+
+    /// Decodes a plain string, or an object with `text` and an optional `terminator`.
+    public init(from decoder: any Decoder) throws {
+        if let text = try? decoder.singleValueContainer().decode(String.self) {
+            self.init(text)
+            return
+        }
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.init(
+            try container.decode(String.self, forKey: .text),
+            terminator: try container.decodeIfPresent(
+                Transcript.Terminator.self, forKey: .terminator) ?? .endOfSequence)
+    }
+
+    /// Encodes a plain string when the terminator is the default.
+    public func encode(to encoder: any Encoder) throws {
+        if terminator == .endOfSequence {
+            var container = encoder.singleValueContainer()
+            try container.encode(text)
+        } else {
+            var container = encoder.container(keyedBy: CodingKeys.self)
+            try container.encode(text, forKey: .text)
+            try container.encode(terminator, forKey: .terminator)
+        }
+    }
+}
