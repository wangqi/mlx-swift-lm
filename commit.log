+    /// during decode. Port of Qwen2-VL's `get_rope_index`.
+    // #239: Qwen25VL.swift getRopeIndex (:1027-1182), verbatim
+    static func getRopeIndex(
+        inputIds: MLXArray,
+        imageGridTHW: [THW]?,
+        videoGridTHW: [THW]?,
+        spatialMergeSize: Int,
+        imageTokenId: Int,
+        videoTokenId: Int,
+        attentionMask: MLXArray? = nil
+    ) -> (MLXArray, MLXArray) {
