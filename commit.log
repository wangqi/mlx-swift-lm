diff --git a/Libraries/MLXScriptedLM/Model/ForwardCallLog.swift b/Libraries/MLXScriptedLM/Model/ForwardCallLog.swift
new file mode 100644
index 0000000..d12809a
--- /dev/null
+++ b/Libraries/MLXScriptedLM/Model/ForwardCallLog.swift
@@ -0,0 +1,66 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+
+/// One call into a ``ScriptedLogitsModel``.
+public struct ForwardCall: Sendable, Equatable {
+
+    public enum Kind: Sendable, Equatable {
+        /// `prepare(_:cache:state:prefill:)`
+        case prepare
+        /// `callAsFunction(_:cache:state:)`
+        case forward
+        /// `nextTokenLogits(_:cache:state:)`
+        case nextTokenLogits
+    }
+
+    /// Input 0 differed from the token the script called for at that position.
+    public struct InputMismatch: Sendable, Equatable {
+        public let position: Int
+        public let expected: Int
+        public let actual: Int
+    }
+
+    public let kind: Kind
+
+    /// The absolute position of input 0: the transcript length before the call.
+    public let cacheOffsetBefore: Int
+    public let inputTokens: [Int]
+
+    /// Tokens the call added to the cache. Less than `inputTokens.count` when `prepare`
+    /// leaves a remainder for the iterator.
+    public let processedTokenCount: Int
+
+    /// The boosted token for each returned logits row, or `nil` where the row was left as is.
+    public let scriptedTokens: [Int?]
+
+    /// The cursor for the last returned row, if it is inside an assistant turn.
+    public let cursor: TurnScripts.Cursor?
+    public let inputMismatch: InputMismatch?
+    public let maskPresent: Bool
+    public let hasInboundState: Bool
+}
+
+/// The calls a ``ScriptedLogitsModel`` has received, safe to read from any thread.
+public final class ForwardCallLog: @unchecked Sendable {
+    private let lock = NSLock()
+    private var storage: [ForwardCall] = []
+
+    public init() {}
+
+    public var calls: [ForwardCall] {
+        lock.withLock { storage }
+    }
+
+    public var inputMismatches: [ForwardCall.InputMismatch] {
+        calls.compactMap(\.inputMismatch)
+    }
+
+    public func removeAll() {
+        lock.withLock { storage.removeAll() }
+    }
+
+    func append(_ call: ForwardCall) {
+        lock.withLock { storage.append(call) }
+    }
+}
diff --git a/Libraries/MLXScriptedLM/Model/ForwardingLanguageModel.swift b/Libraries/MLXScriptedLM/Model/ForwardingLanguageModel.swift
new file mode 100644
index 0000000..e7471f0
--- /dev/null
+++ b/Libraries/MLXScriptedLM/Model/ForwardingLanguageModel.swift
@@ -0,0 +1,170 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLX
+import MLXLMCommon
+import MLXNN
+
+/// A `LanguageModel` that forwards every requirement to a wrapped model.
+///
+/// Subclass it to change one behavior and keep the rest. It implements every
+/// `LanguageModel` requirement itself, so a subclass override is always reached and no
+/// requirement silently falls back to a protocol default.
+///
+/// As a `Module` it is transparent: parameters, children, updates, and freezing go to the
+/// wrapped model with its own keys, not under `wrapped.`. So checkpoint loading,
+/// `sanitize(weights:)`, quantization, and LoRA work through the wrapper.
+///
+/// Optional capabilities that the library detects with `as?`:
+/// - `LoRAModel` and `SuppressedTokensProviding` are forwarded.
+/// - `PreparedInputSplitting`, `SpeculativeCacheRewindModel`, and
+///   `ModelComponentsProviding` are not: conformance cannot depend on the wrapped model,
+///   and conforming with a no-op would change behavior.
+open class ForwardingLanguageModel: Module, LanguageModel, LoRAModel, SuppressedTokensProviding {
+
+    public let wrapped: any LanguageModel
+
+    private var localSuppressedTokenIds = Set<Int>()
+
+    public init(wrapping wrapped: any LanguageModel) {
+        self.wrapped = wrapped
+        super.init()
+    }
+
+    // MARK: - Module
+
+    open override func items() -> ModuleItems {
+        wrapped.items()
+    }
+
+    @discardableResult
+    open override func update(
+        parameters: ModuleParameters, verify: VerifyUpdate, path: [String] = [],
+        modulePath: [String] = []
+    ) throws -> Self {
+        try wrapped.update(
+            parameters: parameters, verify: verify, path: path, modulePath: modulePath)
+        return self
+    }
+
+    @discardableResult
+    open override func update(
+        modules: ModuleChildren, verify: VerifyUpdate, path: [String] = [],
+        modulePath: [String] = []
+    ) throws -> Self {
+        try wrapped.update(modules: modules, verify: verify, path: path, modulePath: modulePath)
+        return self
+    }
+
+    open override func updateModule(key: String, _ value: Any) throws {
+        try wrapped.updateModule(key: key, value)
+    }
+
+    open override func freeze(recursive: Bool = true, keys: [String]? = nil, strict: Bool = false)
+        throws
+    {
+        try wrapped.freeze(recursive: recursive, keys: keys, strict: strict)
+    }
+
+    open override func unfreeze(
+        recursive: Bool = true, keys: [String]? = nil, strict: Bool = false
+    ) throws {
+        try wrapped.unfreeze(recursive: recursive, keys: keys, strict: strict)
+    }
+
+    open override func noGrad() -> Set<String> {
+        wrapped.noGrad()
+    }
+
+    /// `train(_:)` visits the wrapped model's children but not the wrapped model itself.
+    open override func didSetTrain(_ mode: Bool) {
+        wrapped.train(mode)
+    }
+
+    // MARK: - BaseLanguageModel
+
+    open var excludedCheckpointNamespaces: [String] { wrapped.excludedCheckpointNamespaces }
+
+    open func prepareCheckpoint(_ checkpoint: ModelCheckpoint) throws -> ModelCheckpoint {
+        try wrapped.prepareCheckpoint(checkpoint)
+    }
+
+    open func sanitize(weights: [String: MLXArray]) throws -> [String: MLXArray] {
+        try wrapped.sanitize(weights: weights)
+    }
+
+    open func sanitize(weights: [String: MLXArray], metadata: [String: String]) throws
+        -> [String: MLXArray]
+    {
+        try wrapped.sanitize(weights: weights, metadata: metadata)
+    }
+
+    // MARK: - LanguageModel
+
+    open func prepare() throws {
+        try wrapped.prepare()
+    }
+
+    open func prepare(
+        _ input: LMInput, cache: [KVCache], state: LMOutput.State?, prefill: PrefillParameters
+    ) throws -> PrepareResult {
+        try wrapped.prepare(input, cache: cache, state: state, prefill: prefill)
+    }
+
+    open func callAsFunction(_ input: LMInput.Text, cache: [KVCache]?, state: LMOutput.State?)
+        -> LMOutput
+    {
+        wrapped.callAsFunction(input, cache: cache, state: state)
+    }
+
+    open func nextTokenLogits(_ input: LMInput.Text, cache: [KVCache]?, state: LMOutput.State?)
+        -> LMOutput
+    {
+        wrapped.nextTokenLogits(input, cache: cache, state: state)
+    }
+
+    open func callAsFunction(_ inputs: MLXArray, cache: [KVCache]?) -> MLXArray {
+        wrapped.callAsFunction(inputs, cache: cache)
+    }
+
+    open func newCache(parameters: GenerateParameters?) throws -> [KVCache] {
+        try wrapped.newCache(parameters: parameters)
+    }
+
+    open func cacheStatus(parameters: GenerateParameters?) throws -> KVCacheStatus {
+        try wrapped.cacheStatus(parameters: parameters)
+    }
+
+    // MARK: - ChatConventionsProviding
+
+    open var toolCallFormat: ToolCallFormat? { wrapped.toolCallFormat }
+
+    open var reasoningConfig: ReasoningConfig? { wrapped.reasoningConfig }
+
+    // MARK: - LoRAModel
+
+    open var loraLayers: [Module] { (wrapped as? LoRAModel)?.loraLayers ?? [] }
+
+    open var loraDefaultKeys: [String] {
+        if let lora = wrapped as? LoRAModel {
+            return lora.loraDefaultKeys
+        }
+        return []
+    }
+
+    // MARK: - SuppressedTokensProviding
+
+    open var suppressedTokenIds: Set<Int> {
+        get {
+            (wrapped as? SuppressedTokensProviding)?.suppressedTokenIds
+                ?? localSuppressedTokenIds
+        }
+        set {
+            if let provider = wrapped as? SuppressedTokensProviding {
+                provider.suppressedTokenIds = newValue
+            } else {
+                localSuppressedTokenIds = newValue
+            }
+        }
+    }
+}
diff --git a/Libraries/MLXScriptedLM/Model/ScriptedLogitsModel.swift b/Libraries/MLXScriptedLM/Model/ScriptedLogitsModel.swift
new file mode 100644
index 0000000..9b8c766
--- /dev/null
+++ b/Libraries/MLXScriptedLM/Model/ScriptedLogitsModel.swift
@@ -0,0 +1,224 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import MLX
+import MLXLMCommon
+
+/// A model that emits scripted tokens by boosting them in a wrapped model's logits.
+///
+/// The wrapped model (usually small with random weights) does the real work: cache
+/// updates, prefill chunking, and state. This model only raises the scripted token above
+/// each logits row's maximum, so samplers, processors, and masks still see a realistic
+/// distribution.
+///
+/// It appends a ``TranscriptKVCache`` to the wrapped model's caches, and finds the turn
+/// and position from it (see ``TurnScripts``). Generation trims and copies that entry with
+/// the rest of the cache, so the cursor stays right across speculative rejection, prompt
+/// cache reuse, and `ChatSession` rebuilds.
+///
+/// Inside a turn where the script has no token, it blocks
+/// ``TurnScripts/blockedUnscriptedTokens``, so unscripted output cannot end the turn or
+/// start the next one.
+///
+/// Reading the input tokens forces evaluation on every call. That is fine for tests but
+/// removes the iterator's overlap of compute and sampling.
+public final class ScriptedLogitsModel: ForwardingLanguageModel, @unchecked Sendable {
+
+    /// How far above a row's maximum the scripted token goes.
+    public enum Margin: Sendable, Equatable {
+        /// Large enough that samplers and penalties do not override the script.
+        case dominant
+        /// Small: the script wins under greedy decoding, but masks and penalties can beat it.
+        case plausible
+        case custom(Float)
+
+        public var value: Float {
+            switch self {
+            case .dominant: 1000
+            case .plausible: 1
+            case .custom(let value): value
+            }
+        }
+    }
+
+    public let scripts: TurnScripts
+    public let margin: Margin
+    public let callLog = ForwardCallLog()
+
+    /// - Parameters:
+    ///   - wrapped: the model that computes the background logits. Its vocabulary must be
+    ///     at least as large as the largest scripted token id.
+    ///   - scripts: the tokens to emit on each assistant turn.
+    ///   - margin: how strongly to boost the scripted token.
+    public init(
+        wrapping wrapped: any LanguageModel, scripts: TurnScripts, margin: Margin = .dominant
+    ) {
+        self.scripts = scripts
+        self.margin = margin
+        super.init(wrapping: wrapped)
+    }
+
+    /// The tokens recorded in `cache`, or `nil` if it has no ``TranscriptKVCache``.
+    public static func transcript(in cache: [KVCache]) -> [Int]? {
+        (cache.last as? TranscriptKVCache)?.tokens
+    }
+
+    public override func newCache(parameters: GenerateParameters?) throws -> [KVCache] {
+        try wrapped.newCache(parameters: parameters) + [TranscriptKVCache()]
+    }
+
+    /// The status of this model's own cache, which includes the transcript entry.
+    public override func cacheStatus(parameters: GenerateParameters?) throws -> KVCacheStatus {
+        KVCacheStatus(
+            cache: try newCache(parameters: parameters),
+            plan: try parameters?.kvCachePlan() ?? .disabled,
+            phase: .planned)
+    }
+
+    public override func prepare(
+        _ input: LMInput, cache: [KVCache], state: LMOutput.State?, prefill: PrefillParameters
+    ) throws -> PrepareResult {
+        let (inner, transcript) = split(cache)
+        let tokens = Self.tokens(input.text.tokens)
+        let before = transcript?.tokens ?? []
+
+        let result = try wrapped.prepare(input, cache: inner, state: state, prefill: prefill)
+
+        switch result {
+        case .tokens(let remainder):
+            let processed = tokens.count - remainder.cacheSequenceLength
+            transcript?.append(Array(tokens.prefix(processed)))
+            record(
+                .prepare, before: before, input: tokens, processed: processed,
+                cursors: [], mask: input.text.mask, state: state)
+            return result
+
+        case .logits(let output):
+            transcript?.append(tokens)
+            let (logits, cursors) = boost(output.logits, history: before + tokens)
+            record(
+                .prepare, before: before, input: tokens, processed: tokens.count,
+                cursors: cursors, mask: input.text.mask, state: state)
+            return .logits(LMOutput(logits: logits, state: output.state))
+        }
+    }
+
+    public override func callAsFunction(
+        _ input: LMInput.Text, cache: [KVCache]?, state: LMOutput.State?
+    ) -> LMOutput {
+        forward(.forward, input, cache: cache, state: state) { inner in
+            wrapped.callAsFunction(input, cache: inner, state: state)
+        }
+    }
+
+    public override func nextTokenLogits(
+        _ input: LMInput.Text, cache: [KVCache]?, state: LMOutput.State?
+    ) -> LMOutput {
+        forward(.nextTokenLogits, input, cache: cache, state: state) { inner in
+            wrapped.nextTokenLogits(input, cache: inner, state: state)
+        }
+    }
+
+    public override func callAsFunction(_ inputs: MLXArray, cache: [KVCache]?) -> MLXArray {
+        callAsFunction(LMInput.Text(tokens: inputs), cache: cache, state: nil).logits
+    }
+
+    // MARK: - Implementation
+
+    private func forward(
+        _ kind: ForwardCall.Kind, _ input: LMInput.Text, cache: [KVCache]?,
+        state: LMOutput.State?, body: ([KVCache]?) -> LMOutput
+    ) -> LMOutput {
+        let (inner, transcript) = split(cache ?? [])
+        let tokens = Self.tokens(input.tokens)
+        let before = transcript?.tokens ?? []
+
+        let output = body(cache == nil ? nil : inner)
+        transcript?.append(tokens)
+
+        let (logits, cursors) = boost(output.logits, history: before + tokens)
+        record(
+            kind, before: before, input: tokens, processed: tokens.count,
+            cursors: cursors, mask: input.mask, state: state)
+        return LMOutput(logits: logits, state: output.state)
+    }
+
+    /// Separates the transcript entry from the wrapped model's caches.
+    private func split(_ cache: [KVCache]) -> ([KVCache], TranscriptKVCache?) {
+        if let transcript = cache.last as? TranscriptKVCache {
+            return (Array(cache.dropLast()), transcript)
+        }
+        precondition(
+            cache.isEmpty,
+            "ScriptedLogitsModel needs the cache from its own newCache(parameters:), which ends with a TranscriptKVCache"
+        )
+        return (cache, nil)
+    }
+
+    private static func tokens(_ array: MLXArray) -> [Int] {
+        precondition(
+            array.ndim <= 1 || array.dim(0) == 1, "ScriptedLogitsModel supports batch size 1")
+        return array.asType(.int32).asArray(Int32.self).map(Int.init)
+    }
+
+    /// Boosts the scripted token in each row, and blocks EOS and the turn marker in rows
+    /// inside a turn with no scripted token. Rows are the last positions of `history`.
+    private func boost(_ logits: MLXArray, history: [Int]) -> (MLXArray, [TurnScripts.Cursor?]) {
+        precondition(logits.dim(0) == 1, "ScriptedLogitsModel supports batch size 1")
+        let rows = logits.dim(1)
+        let vocabularySize = logits.dim(-1)
+        let cursors = Array(scripts.cursors(for: history).suffix(rows))
+        let targets = cursors.map { $0.flatMap(scripts.token(at:)) }
+        let unscripted = zip(cursors, targets).map { $0 != nil && $1 == nil }
+
+        guard targets.contains(where: { $0 != nil }) || unscripted.contains(true) else {
+            return (logits, cursors)
+        }
+        for target in targets.compactMap({ $0 }) {
+            precondition(
+                target < vocabularySize,
+                "scripted token \(target) is outside the wrapped model's vocabulary (\(vocabularySize))"
+            )
+        }
+
+        let ids = MLXArray(Array(Int32(0) ..< Int32(vocabularySize))).reshaped(1, 1, vocabularySize)
+        let targetArray = MLXArray(targets.map { Int32($0 ?? -1) }).reshaped(1, rows, 1)
+        let boosted = logits.max(axis: -1, keepDims: true) + margin.value
+        var result = which(ids .== targetArray, boosted, logits)
+
+        if unscripted.contains(true) {
+            let blockedTokens = scripts.blockedUnscriptedTokens
+            let blocked = MLXArray((0 ..< vocabularySize).map { blockedTokens.contains($0) })
+                .reshaped(1, 1, vocabularySize)
+            let rowMask = MLXArray(unscripted).reshaped(1, rows, 1)
+            result = which(
+                blocked .&& rowMask, MLXArray(-Float.infinity).asType(logits.dtype), result)
+        }
+        return (result, cursors)
+    }
+
+    private func record(
+        _ kind: ForwardCall.Kind, before: [Int], input: [Int], processed: Int,
+        cursors: [TurnScripts.Cursor?], mask: MLXArray?, state: LMOutput.State?
+    ) {
+        var mismatch: ForwardCall.InputMismatch?
+        if let actual = input.first, let previous = before.indices.last,
+            let cursor = scripts.cursors(for: before)[previous],
+            let expected = scripts.token(at: cursor), expected != actual
+        {
+            mismatch = .init(position: before.count, expected: expected, actual: actual)
+        }
+
+        callLog.append(
+            ForwardCall(
+                kind: kind,
+                cacheOffsetBefore: before.count,
+                inputTokens: input,
+                processedTokenCount: processed,
+                scriptedTokens: cursors.map { $0.flatMap(scripts.token(at:)) },
+                cursor: cursors.last ?? nil,
+                inputMismatch: mismatch,
+                maskPresent: mask != nil,
+                hasInboundState: state != nil))
+    }
+}
