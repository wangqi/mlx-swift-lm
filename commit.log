commit 39b92df3fb8aece825ae57687d8851b06da0d5cf
Author: Reid Chatham <reid.chatham@gmail.com>
Date:   Wed Oct 28 13:53:58 2026 -0700

    Read Gemma 3 RoPE scaling from rope_parameters (#723)
    
    * Read Gemma 3 RoPE scaling from rope_parameters
    
    transformers 4.57+ exports set rope_scaling to null and write the
    scaling to rope_parameters, either keyed by layer type
    ({"full_attention": {...}, "sliding_attention": {...}}) or flat.
    Gemma3TextConfiguration in MLXLLM and MLXVLM only read rope_scaling, so
    for those checkpoints (e.g. TranslateGemma) the global-attention layers
    ran without the x8 linear factor. Both now fall back to rope_parameters
    when rope_scaling is absent or null.
    
    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/Libraries/MLXLLM/Models/Gemma3Text.swift b/Libraries/MLXLLM/Models/Gemma3Text.swift
index a333b94..591c62c 100644
--- a/Libraries/MLXLLM/Models/Gemma3Text.swift
+++ b/Libraries/MLXLLM/Models/Gemma3Text.swift
@@ -125,6 +125,12 @@ public struct Gemma3TextConfiguration: Codable {
         case textConfig = "text_config"
     }
 
+    // Kept out of `CodingKeys` so the synthesized `Encodable` is unchanged.
+    private enum RopeParametersCodingKeys: String, CodingKey {
+        case textConfig = "text_config"
+        case ropeParameters = "rope_parameters"
+    }
+
     public init(from decoder: Decoder) throws {
         let nestedContainer = try decoder.container(keyedBy: VLMCodingKeys.self)
 
@@ -162,6 +168,28 @@ public struct Gemma3TextConfiguration: Codable {
             try container.decodeIfPresent(Int.self, forKey: .maxPositionEmbeddings) ?? 32768
         ropeScaling =
             try container.decodeIfPresent([String: StringOrNumber].self, forKey: .ropeScaling)
+            ?? Self.fullAttentionRopeParameters(from: decoder)
+    }
+
+    /// Newer `transformers` exports set `rope_scaling` to null and write `rope_parameters`
+    /// instead, either keyed by layer type or flat.
+    private static func fullAttentionRopeParameters(
+        from decoder: Decoder
+    ) -> [String: StringOrNumber]? {
+        guard var container = try? decoder.container(keyedBy: RopeParametersCodingKeys.self)
+        else { return nil }
+        if let textConfig = try? container.nestedContainer(
+            keyedBy: RopeParametersCodingKeys.self, forKey: .textConfig)
+        {
+            container = textConfig
+        }
+        if let byLayerType = try? container.decodeIfPresent(
+            [String: [String: StringOrNumber]].self, forKey: .ropeParameters)
+        {
+            return byLayerType["full_attention"]
+        }
+        return try? container.decodeIfPresent(
+            [String: StringOrNumber].self, forKey: .ropeParameters)
     }
 }
 
diff --git a/Libraries/MLXVLM/Models/Gemma3.swift b/Libraries/MLXVLM/Models/Gemma3.swift
index fc62e0f..2b66203 100644
--- a/Libraries/MLXVLM/Models/Gemma3.swift
+++ b/Libraries/MLXVLM/Models/Gemma3.swift
@@ -66,6 +66,46 @@ public struct Gemma3TextConfiguration: Codable, Sendable {
         case _headDim = "head_dim"
         case _queryPreAttnScalar = "query_pre_attn_scalar"
     }
+
+    // Kept out of `CodingKeys` so the synthesized `Encodable` is unchanged.
+    private enum RopeParametersCodingKeys: String, CodingKey {
+        case ropeParameters = "rope_parameters"
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        modelType = try container.decode(String.self, forKey: .modelType)
+        hiddenSize = try container.decode(Int.self, forKey: .hiddenSize)
+        hiddenLayers = try container.decode(Int.self, forKey: .hiddenLayers)
+        intermediateSize = try container.decode(Int.self, forKey: .intermediateSize)
+        slidingWindow = try container.decode(Int.self, forKey: .slidingWindow)
+        ropeScaling =
+            try container.decodeIfPresent([String: StringOrNumber].self, forKey: .ropeScaling)
+            ?? Self.fullAttentionRopeParameters(from: decoder)
+        finalLogitSoftcapping = try container.decodeIfPresent(
+            Float.self, forKey: .finalLogitSoftcapping)
+        _attentionHeads = try container.decodeIfPresent(Int.self, forKey: ._attentionHeads)
+        _kvHeads = try container.decodeIfPresent(Int.self, forKey: ._kvHeads)
+        _headDim = try container.decodeIfPresent(Int.self, forKey: ._headDim)
+        _queryPreAttnScalar = try container.decodeIfPresent(
+            Float.self, forKey: ._queryPreAttnScalar)
+    }
+
+    /// Newer `transformers` exports set `rope_scaling` to null and write `rope_parameters`
+    /// instead, either keyed by layer type or flat.
+    private static func fullAttentionRopeParameters(
+        from decoder: Decoder
+    ) -> [String: StringOrNumber]? {
+        guard let container = try? decoder.container(keyedBy: RopeParametersCodingKeys.self)
+        else { return nil }
+        if let byLayerType = try? container.decodeIfPresent(
+            [String: [String: StringOrNumber]].self, forKey: .ropeParameters)
+        {
+            return byLayerType["full_attention"]
+        }
+        return try? container.decodeIfPresent(
+            [String: StringOrNumber].self, forKey: .ropeParameters)
+    }
 }
 
