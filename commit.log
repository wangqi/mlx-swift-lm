+            l = l * exp_diff + exp_score;
+            m = new_m;
+        }
+
+        // Write partial results: o[D], m, l
+        uint partial_base = (q_idx * num_blocks + block_idx) * Dim;
+        for (uint i = 0; i < DIMS_PER_LANE; i++) {
+            uint d = lane + i * 32;
+            if (d < Dim) {
