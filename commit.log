diff --git a/Tests/MLXLMTests/ReasoningChannelTests.swift b/Tests/MLXLMTests/ReasoningChannelTests.swift
new file mode 100644
index 0000000..94d4c22
--- /dev/null
+++ b/Tests/MLXLMTests/ReasoningChannelTests.swift
@@ -0,0 +1,467 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import Testing
+import XCTest
+
+@testable import MLXLLM
+@testable import MLXLMCommon
+
+/// Labeled-channel reasoning (``ReasoningChannel``), the protocol Gemma 4 uses:
+/// `<|channel>LABEL\n ... <channel|>`, where the label decides whether the span is
+/// reasoning or the answer.
+@Suite
+struct ReasoningChannelTests {
+
+    // MARK: - Fixtures & helpers
+
+    /// Gemma 4's protocol, spelled out rather than taken from
+    /// ``ReasoningConfig/gemma4`` so these tests pin the emitter's behavior against a
+    /// literal shape; the preset itself is pinned separately by `gemma4Preset()`.
+    private static let gemma4 = ReasoningConfig(
+        startDelimiter: "<|channel>", endDelimiter: "<channel|>",
+        promptStrategy: .templateFlag(key: "enable_thinking", defaultOn: false),
+        isSpecialToken: true,
+        channel: .gemma4)
+
+    private typealias Segment = ReasoningEventEmitter.Segment
+
+    private func run(
+        config: ReasoningConfig = gemma4, primedInside: Bool = false, _ chunks: [String]
+    ) -> [Segment] {
+        var emitter = ReasoningEventEmitter(config: config, primedInside: primedInside)
+        var segments: [Segment] = []
+        for chunk in chunks { segments += emitter.process(chunk) }
+        segments += emitter.finalize()
+        return segments
+    }
+
+    private func text(_ segments: [Segment]) -> String {
+        segments.map {
+            switch $0 {
+            case .reasoning(let s), .response(let s): s
+            }
+        }.joined()
+    }
+
+    private func reasoningText(_ segments: [Segment]) -> String {
+        segments.compactMap { if case .reasoning(let s) = $0 { return s } else { return nil } }
+            .joined()
+    }
+
+    private func responseText(_ segments: [Segment]) -> String {
+        segments.compactMap { if case .response(let s) = $0 { return s } else { return nil } }
+            .joined()
+    }
+
+    private func leaksMarker(_ segments: [Segment]) -> Bool {
+        let all = text(segments)
+        return all.contains("<|channel>") || all.contains("<channel|>")
+    }
+
+    // MARK: - The production case
+
+    /// Gemma 4's 31B chat template prefills a closed, empty thought block after
+    /// `<|turn>model` when thinking is off - but suppresses the whole generation
+    /// prompt when the previous message was a tool call or tool response. The model
+    /// is then the one to open the channel, on exactly the answer that follows a
+    /// tool result. (The E2B template prefills nothing at all, so the same shape
+    /// can arrive on a first answer.)
+    @Test func emptyThoughtBlockThenAnswer() {
+        let segments = run(["<|channel>thought\n<channel|>answer"])
+        #expect(segments == [.response("answer")])
+        #expect(!leaksMarker(segments))
+    }
+
+    /// The same input delivered one character at a time must resolve identically:
+    /// both markers are 10 characters, so a splitter sized for `</think>` tears them.
+    @Test func emptyThoughtBlockOneCharacterAtATime() {
+        let segments = run("<|channel>thought\n<channel|>answer".map { String($0) })
+        #expect(responseText(segments) == "answer")
+        #expect(reasoningText(segments).isEmpty)
+        #expect(!leaksMarker(segments))
+    }
+
+    @Test func thoughtChannelRoutesToReasoning() {
+        let segments = run(["<|channel>thought\nweighing it up<channel|>the answer"])
+        #expect(segments == [.reasoning("weighing it up"), .response("the answer")])
+    }
+
+    /// A label listed in `responseLabels` routes to the answer. Defensive rather
+    /// than observed for Gemma 4 (no shipped template emits a `content` channel),
+    /// but the routing has to exist: sending every channel to reasoning would
+    /// swallow the reply.
+    @Test func responseLabelledChannelIsNotReasoning() {
+        let segments = run(["<|channel>content\nanswer<channel|>"])
+        #expect(segments == [.response("answer")])
+        #expect(reasoningText(segments).isEmpty)
+    }
+
+    @Test func labelIsNeverEmitted() {
+        let segments = run(["<|channel>thought\nthinking<channel|>"])
+        #expect(reasoningText(segments) == "thinking")
+        #expect(!text(segments).contains("thought"))
+    }
+
+    // MARK: - Chunk-boundary robustness
+
+    @Test func markersSplitAcrossChunks() {
+        let segments = run(["<|chan", "nel>thou", "ght\nidea<chan", "nel|>done"])
+        #expect(reasoningText(segments) == "idea")
+        #expect(responseText(segments) == "done")
+        #expect(!leaksMarker(segments))
+    }
+
+    @Test func labelTerminatorArrivesInALaterChunk() {
+        let segments = run(["<|channel>thou", "ght", "\n", "idea<channel|>done"])
+        #expect(reasoningText(segments) == "idea")
+        #expect(responseText(segments) == "done")
+    }
+
+    /// State survives across `process(_:)` calls, so a block is still classified when
+    /// it is split at any point - including by a caller that keeps one emitter across
+    /// separate generation passes, which is how a reasoning block spanning a tool call
+    /// stays intact.
+    @Test func blockSpanningTwoProcessCalls() {
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        var segments = emitter.process("<|channel>thought\nfirst half")
+        #expect(emitter.isInsideReasoning)
+        segments += emitter.process(" second half<channel|>answer")
+        #expect(reasoningText(segments) == "first half second half")
+        #expect(responseText(segments) == "answer")
+        #expect(!emitter.isInsideReasoning)
+    }
+
+    /// Chunking must not change the classification. This feeds a corpus through
+    /// every split shape - whole, one character at a time, and a spread of fixed
+    /// widths that land inside both 10-character markers and inside the label - and
+    /// requires the same text on the same side every time.
+    ///
+    /// Whitespace is normalized before comparing, and only whitespace: answer text
+    /// before a marker loses its trailing whitespace only when both land in the same
+    /// chunk. A thought holds its trailing whitespace, so it does not vary.
+    @Test func chunkingNeverChangesClassification() {
+        let corpus = [
+            "<|channel>thought\nreasoning<channel|>answer",
+            "<|channel>thought\n<channel|>answer",
+            "<|channel>content\nanswer<channel|>",
+            "<|channel>scratchpad\nnotes<channel|>answer",
+            "plain answer with no channel at all",
+            "answer<channel|>after a stray close",
+            "<|channel|>analysis<|message|>harmony is inert",
+            "<|channel>thought\na<channel|>b<|channel>thought\nc<channel|>d",
+            "<|channel>thought\na<|channel>thought\nb<channel|>c",
+            "<|channel>thought\ncontains <|tool_call>syntax<channel|>answer",
+            "trailing partial marker <|chan",
+            "<|channel>\(String(repeating: "y", count: 33))\nlabel ran past the window<channel|>a",
+        ]
+
+        for input in corpus {
+            let whole = run([input])
+            for width in [1, 2, 3, 5, 7, 9, 10, 11, 17] {
+                let chunks = stride(from: 0, to: input.count, by: width).map { start -> String in
+                    let from = input.index(input.startIndex, offsetBy: start)
+                    let to = input.index(from, offsetBy: width, limitedBy: input.endIndex)
+                    return String(input[from ..< (to ?? input.endIndex)])
+                }
+                let split = run(chunks)
+                #expect(
+                    normalized(reasoningText(split)) == normalized(reasoningText(whole)),
+                    "reasoning differs at width \(width) for \(input.debugDescription)")
+                #expect(
+                    normalized(responseText(split)) == normalized(responseText(whole)),
+                    "response differs at width \(width) for \(input.debugDescription)")
+                #expect(!leaksMarker(split), "marker leaked at width \(width)")
+            }
+        }
+    }
+
+    private func normalized(_ text: String) -> String {
+        text.split(whereSeparator: \.isWhitespace).joined(separator: " ")
+    }
+
+    // MARK: - Adversarial input
+
+    /// Harmony's markers (`<|channel|>analysis<|message|>`) have pipes on BOTH
+    /// sides. Neither Gemma 4 token is a substring of them, and a sloppy `contains`
+    /// implementation eats text here.
+    @Test func harmonyMarkersAreInertText() {
+        let segments = run(["<|channel|>analysis<|message|>hello"])
+        #expect(segments == [.response("<|channel|>analysis<|message|>hello")])
+    }
+
+    /// Both delimiters are special tokens, so an end delimiter with no opener cannot
+    /// be prose: the PROMPT opened the channel. The text before it has already
+    /// streamed out and cannot be reclassified, but the marker itself must not reach
+    /// the answer.
+    @Test func strayEndDelimiterIsSwallowedNotLeaked() {
+        let segments = run(["already answering<channel|>rest of the answer"])
+        #expect(!leaksMarker(segments))
+        #expect(responseText(segments) == "already answeringrest of the answer")
+    }
+
+    /// An opener whose label never terminates must not buffer without bound: past
+    /// the label window the opener is malformed, and its text is shown (as
+    /// reasoning) rather than silently swallowed up to some distant closer.
+    @Test func unterminatedLabelDoesNotBufferUnboundedly() {
+        let long = String(repeating: "x", count: 200)
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        let segments = emitter.process("<|channel>" + long)
+        // Exact, not a prefix check: a partial swallow would still pass `hasPrefix`.
+        #expect(reasoningText(segments) == long)
+        #expect(emitter.isInsideReasoning)
+    }
+
+    /// A terminator just past the window does not end the label, and the text it would
+    /// have labeled stays visible. This pins the `maxLabelLength` boundary itself,
+    /// which the chunk-invariance corpus reaches only from inside the window.
+    @Test func terminatorPastTheWindowIsNotALabel() {
+        let label = String(repeating: "y", count: 33)
+        let segments = run(["<|channel>\(label)\nbody<channel|>answer"])
+
+        #expect(reasoningText(segments) == "\(label)\nbody")
+        #expect(responseText(segments) == "answer")
+        #expect(!leaksMarker(segments))
+    }
+
+    /// Hiding an unrecognized channel in the reasoning stream is the safe
+    /// direction: the text stays readable and no scratchpad text reaches the answer.
+    @Test func unknownLabelRoutesToReasoning() {
+        let segments = run(["<|channel>scratchpad\nnotes<channel|>answer"])
+        #expect(segments == [.reasoning("notes"), .response("answer")])
+    }
+
+    /// A channel config that declares no implicit end keeps tool syntax inside a
+    /// thought as reasoning, so it never reaches the tool-call parser. The shipped
+    /// ``ReasoningConfig/gemma4`` preset does declare `<|tool_call>` as one, and
+    /// `GenerationReasoningRoutingTests` pins that path.
+    @Test func toolSyntaxInsideThoughtStaysReasoning() {
+        let segments = run(["<|channel>thought\nI could emit <|tool_call>here<channel|>Hi"])
+        #expect(reasoningText(segments) == "I could emit <|tool_call>here")
+        #expect(responseText(segments) == "Hi")
+    }
+
+    /// Channels do not nest: a second opener ends the open channel, and the new
+    /// channel routes by its own label. Neither marker reaches either stream.
+    @Test func nestedOpenerStartsTheNextChannel() {
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        var segments = emitter.process("<|channel>thought\na<|channel>content\nanswer<channel|>")
+        segments += emitter.finalize()
+        #expect(segments == [.reasoning("a"), .response("answer")])
+        #expect(emitter.hasClosedReasoning)
+    }
+
+    @Test func nestedOpenerThatNeverClosesFlushesAsReasoning() {
+        let segments = run(["<|channel>thought\na<|channel>thought\nb"])
+        #expect(segments == [.reasoning("a"), .reasoning("b")])
+        #expect(!leaksMarker(segments))
+    }
+
+    // MARK: - Primed state
+
+    @Test func primedInsideClosesOnEndDelimiter() {
+        let segments = run(primedInside: true, ["carried thought<channel|>answer"])
+        #expect(segments == [.reasoning("carried thought"), .response("answer")])
+    }
+
+    @Test func primedNeverClosesFlushesAsReasoning() {
+        let segments = run(primedInside: true, ["thinking with no close"])
+        #expect(segments == [.reasoning("thinking with no close")])
+    }
+
+    // MARK: - State signals
+
+    @Test func isInsideReasoningIsTrueWhileReadingTheLabel() {
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        #expect(!emitter.isInsideReasoning)
+        _ = emitter.process("<|channel>tho")
+        #expect(emitter.isInsideReasoning)
+    }
+
+    @Test func isInsideReasoningIsFalseInsideTheContentChannel() {
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        _ = emitter.process("<|channel>content\npartial answer")
+        #expect(!emitter.isInsideReasoning)
+    }
+
+    @Test func hasClosedReasoningLatchesForThoughtOnly() {
+        var thought = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        _ = thought.process("<|channel>thought\nx<channel|>")
+        #expect(thought.hasClosedReasoning)
+
+        var content = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        _ = content.process("<|channel>content\nx<channel|>")
+        #expect(!content.hasClosedReasoning)
+    }
+
+    /// A malformed opener that closes before its label ever terminates still closed a
+    /// channel the scanner was reporting as reasoning, so the latch must fire - or a
+    /// think-then-call collector waiting on it would never be released.
+    @Test func hasClosedReasoningLatchesForAnUnterminatedLabel() {
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        _ = emitter.process("<|channel>oops<channel|>answer")
+        #expect(emitter.hasClosedReasoning)
+        #expect(!emitter.isInsideReasoning)
+    }
+
+    /// The empty block opens and closes within one `process` call, so sampling
+    /// `isInsideReasoning` afterwards cannot see it.
+    @Test func hasClosedReasoningDetectsTheEmptyBlock() {
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        _ = emitter.process("<|channel>thought\n<channel|>answer")
+        #expect(emitter.hasClosedReasoning)
+        #expect(!emitter.isInsideReasoning)
+    }
+
+    @Test func finalizeFlushesAnUnterminatedLabelAsReasoning() {
+        var emitter = ReasoningEventEmitter(config: Self.gemma4, primedInside: false)
+        _ = emitter.process("<|channel>tho")
+        let flushed = emitter.finalize()
+        #expect(flushed == [.reasoning("tho")])
+    }
+
+    // MARK: - Prompt priming detection
+
+    /// The template's own prefill for thinking-off: a CLOSED empty block, so the
+    /// stream that follows starts outside.
+    @Test func closedPrefillIsNotPrimed() {
+        #expect(
+            !ReasoningEventEmitter.promptEndsInsideReasoning(
+                renderedPromptTail: "<|turn>model\n<|channel>thought\n<channel|>",
+                config: Self.gemma4))
+    }
+
+    @Test func openChannelInPromptIsPrimed() {
+        #expect(
+            ReasoningEventEmitter.promptEndsInsideReasoning(
+                renderedPromptTail: "<|turn>model\n<|channel>thought\n", config: Self.gemma4))
+    }
+
+    /// Gemma 4's real prompt for a user who typed `<|channel>`: E2B either way, 31B with
+    /// thinking on. The typed text tokenizes to special token 100, like the template's.
+    @Test func channelOpenerInUserTurnIsNotPrimed() {
+        #expect(
+            !ReasoningEventEmitter.promptEndsInsideReasoning(
+                renderedPromptTail:
+                    "<|turn>user\nWhat does <|channel> mean in a chat template?<turn|>\n"
+                    + "<|turn>model\n",
+                config: Self.gemma4))
+    }
+
+    /// The 31B template's thinking-off prompt for the same user turn.
+    @Test func closedPrefillAfterChannelOpenerInUserTurnIsNotPrimed() {
+        #expect(
+            !ReasoningEventEmitter.promptEndsInsideReasoning(
+                renderedPromptTail:
+                    "<|turn>user\nWhat does <|channel> mean in a chat template?<turn|>\n"
+                    + "<|turn>model\n<|channel>thought\n<channel|>",
+                config: Self.gemma4))
+    }
+
+    /// Gemma 4 writes no generation prompt after a tool response, so the tool's own
+    /// text ends the prompt. An opener inside it is not a prefill.
+    @Test func channelOpenerInToolResponseIsNotPrimed() {
+        #expect(
+            !ReasoningEventEmitter.promptEndsInsideReasoning(
+                renderedPromptTail:
+                    "<|tool_response>response:read_file{value:<|\"|>The opener is <|channel>."
+                    + "<|\"|>}<tool_response|>",
+                config: Self.gemma4))
+    }
+
+    /// After a tool response the template emits no generation prompt at all, so
+    /// nothing is primed and the model opens the channel itself.
+    @Test func toolResponseTailIsNotPrimed() {
+        #expect(
+            !ReasoningEventEmitter.promptEndsInsideReasoning(
+                renderedPromptTail: "response:get_weather{value:sunny}<tool_response|>",
+                config: Self.gemma4))
+    }
+
+    // MARK: - Delimiter-pair configs are unaffected
+
+    @Test func pairedConfigIgnoresChannelMarkers() {
+        let think = ReasoningConfig(
+            startDelimiter: "<think>", endDelimiter: "</think>", promptStrategy: .alwaysOn)
+        let segments = run(config: think, ["<|channel>thought\nx<channel|>y"])
+        #expect(segments == [.response("<|channel>thought\nx<channel|>y")])
+    }
+
+    // MARK: - Model declaration
+
+    /// The Gemma 4 model types declare this through `ChatConventionsProviding`, so the
+    /// shared preset is what those declarations resolve to.
+    @Test func gemma4Preset() {
+        let config = ReasoningConfig.gemma4
+        #expect(config.startDelimiter == "<|channel>")
+        #expect(config.endDelimiter == "<channel|>")
+        #expect(config.channel == .gemma4)
+        #expect(config.isSpecialToken)
+        #expect(config.promptStrategy == .templateFlag(key: "enable_thinking", defaultOn: false))
+        #expect(config.implicitEndDelimiters == ["<|tool_call>"])
+    }
+
+    /// The trailing whitespace of a thought channel is held until the close, as for
+    /// a delimiter pair, so the recorded thought does not depend on the chunking.
+    @Test func thoughtChannelHoldsTrailingWhitespaceAcrossChunks() {
+        let segments = run(["<|channel>thought\n", "a", " \n", "<channel|>", "b"])
+        #expect(segments == [.reasoning("a"), .response("b")])
+    }
+
+    /// The delimiter-pair presets keep a `nil` channel, so adding the channel shape
+    /// leaves every family that used them on the path they were already on.
+    @Test func pairedPresetsHaveNoChannel() {
+        #expect(ReasoningConfig.thinkTagsWithEnableThinking.channel == nil)
+        #expect(ReasoningConfig.alwaysOnThinking.channel == nil)
+    }
+}
+
+// MARK: - Declaration scope
+//
+// XCTest, and colocated with `ChatConventionsTests`' style, because these go through
+// `LLMTypeRegistry` the way that file does rather than constructing a model type
+// directly. Tiny random-weight config, so they run in CI without downloads.
+final class ReasoningChannelDeclarationTests: XCTestCase {
+
+    /// Gemma 3 and earlier have no reasoning protocol, and nothing about this change
+    /// gives them one. The risk this guards is an over-broad declaration: nothing stops
+    /// an extension from landing on a shared base or on the wrong class, and a Gemma 3
+    /// model that suddenly reported `.gemma4` would hide its answers in the thought
+    /// stream. `Gemma4TextTests.declaresChannelReasoningConfig` is the positive half of
+    /// this pair - it builds a real `Gemma4TextModel` and requires the declaration to be
+    /// there - so this `nil` means "Gemma 3 declares none", not "nothing declares
+    /// anything".
+    ///
+    /// Only `model_type` is required; the rest override Gemma 3's full-size defaults so
+    /// the model is small enough to build in a test without downloading weights.
+    func testGemma3DeclaresNoReasoningConfig() async throws {
+        let json = """
+            {
+                "model_type": "gemma3",
+                "hidden_size": 16,
+                "num_hidden_layers": 1,
+                "intermediate_size": 32,
+                "num_attention_heads": 2,
+                "num_key_value_heads": 1,
+                "head_dim": 8,
+                "rms_norm_eps": 1e-6,
+                "vocab_size": 64
+            }
+            """
+        let model = try await LLMTypeRegistry.shared.createModel(
+            configuration: Data(json.utf8), modelType: "gemma3")
+        XCTAssertNil(model.reasoningConfig)
+    }
+
+    /// No registered resolver claims the ids these two families actually ship under, so
+    /// nothing overrides the declarations above. Resolvers are keyed on id and type, so
+    /// representative ids are the most this can assert.
+    func testNoResolverClaimsGemma() {
+        XCTAssertNil(
+            ChatConventionsRegistry.shared.reasoningConfig(
+                modelId: "mlx-community/gemma-3-27b-it-4bit", modelType: "gemma3"))
+        XCTAssertNil(
+            ChatConventionsRegistry.shared.reasoningConfig(
+                modelId: "mlx-community/gemma-4-31b-it-4bit", modelType: "gemma4_text"))
+    }
+}
diff --git a/Tests/MLXLMTests/ReasoningDelimiterTokenTests.swift b/Tests/MLXLMTests/ReasoningDelimiterTokenTests.swift
new file mode 100644
index 0000000..5a8e5fa
--- /dev/null
+++ b/Tests/MLXLMTests/ReasoningDelimiterTokenTests.swift
@@ -0,0 +1,556 @@
+// Copyright © 2026 Apple Inc.
+
+import Foundation
+import Testing
+
+@testable import MLXLMCommon
+
+/// Reasoning delimiters matched by token id.
+///
+/// When both delimiters are single tokens, only those ids open and close a span.
+/// The same characters arriving as ordinary text tokens are content.
+@Suite("Reasoning delimiter tokens")
+struct ReasoningDelimiterTokenTests {
+
+    // MARK: - Harness
+
+    /// Maps ids to text. Ids below 10 are control tokens: only they resolve from
+    /// their text, as a real tokenizer resolves only its control tokens whole.
+    private struct VocabularyTokenizer: Tokenizer {
+        let vocabulary: [Int: String]
+
+        func encode(text: String, addSpecialTokens: Bool) -> [Int] { [] }
+        func decode(tokenIds: [Int], skipSpecialTokens: Bool) -> String {
+            tokenIds.map { vocabulary[$0] ?? "" }.joined()
+        }
+        func convertTokenToId(_ token: String) -> Int? {
+            vocabulary.filter { $0.key < 10 && $0.value == token }.keys.min()
+        }
+        func convertIdToToken(_ id: Int) -> String? { vocabulary[id] }
+        var bosToken: String? { nil }
+        var eosToken: String? { nil }
+        var unknownToken: String? { nil }
+        func applyChatTemplate(
+            messages: [[String: any Sendable]],
+            tools: [[String: any Sendable]]?,
+            additionalContext: [String: any Sendable]?
+        ) throws -> [Int] { [] }
+    }
+
+    private struct Collected {
+        var reasoning: [String] = []
+        var response: [String] = []
+        var toolCalls: [ToolCall] = []
+        var stopped = false
+
+        var reasoningText: String { reasoning.joined() }
+        var responseText: String { response.joined() }
+    }
+
+    /// Ids 1 and 2 are the config's delimiters as control tokens, and id 3 is
+    /// `<tool_call>` as one when `toolCallToken` is set. Every other fragment gets
+    /// its own id, even when it spells a delimiter.
+    private func run(
+        _ fragments: [Fragment],
+        config: ReasoningConfig,
+        format: ToolCallFormat = .json,
+        stopStrings: Set<String> = [],
+        primedInside: Bool = false,
+        toolCallToken: Bool = false
+    ) -> Collected {
+        var vocabulary = [1: config.startDelimiter, 2: config.endDelimiter]
+        if toolCallToken { vocabulary[3] = "<tool_call>" }
+        var ids: [Int] = []
+        for (offset, fragment) in fragments.enumerated() {
+            switch fragment {
+            case .open: ids.append(1)
+            case .close: ids.append(2)
+            case .toolCall: ids.append(3)
+            case .text(let text):
+                vocabulary[offset + 10] = text
+                ids.append(offset + 10)
+            }
+        }
+        var decoder = StandardTokenStreamDecoder(
+            tokenizer: VocabularyTokenizer(vocabulary: vocabulary),
+            format: format,
+            tools: nil,
+            stopStrings: stopStrings,
+            reasoning: (config: config, primedInside: primedInside))
+
+        var collected = Collected()
+        func consume(_ event: TokenStreamEvent) -> Bool {
+            switch event {
+            case .reasoning(let text): collected.reasoning.append(text)
+            case .response(let text): collected.response.append(text)
+            case .toolCall(let call): collected.toolCalls.append(call)
+            case .rejectedToolCall, .protocolError: break
+            case .stop: collected.stopped = true
+            }
+            return true
+        }
+        for id in ids {
+            if !decoder.push(id, emit: consume) { break }
+        }
+        _ = decoder.finish(emit: consume)
+        return collected
+    }
+
+    private enum Fragment: ExpressibleByStringLiteral {
+        case open
+        case close
+        case toolCall
+        case text(String)
+
+        init(stringLiteral value: String) { self = .text(value) }
+    }
+
+    private var qwen: ReasoningConfig { QwenReasoningProtocol.tagged }
+
+    // MARK: - Resolution
+
+    @Test("Delimiters resolve only when each is one token that decodes to itself")
+    func resolution() {
+        let whole = VocabularyTokenizer(vocabulary: [1: "<think>", 2: "</think>"])
+        let tokens = ReasoningDelimiterTokens(config: qwen, tokenizer: whole)
+        #expect(tokens?.start == 1)
+        #expect(tokens?.end == 2)
+        #expect(tokens?.boundary(for: 1) == .start)
+        #expect(tokens?.boundary(for: 2) == .end)
+        #expect(tokens?.boundary(for: 3) == nil)
+        #expect(tokens?.implicitEndDelimiters == [])
+
+        // An implicit end delimiter resolves on its own, when it is a token.
+        let withCall = VocabularyTokenizer(
+            vocabulary: [1: "<think>", 2: "</think>", 3: "<tool_call>"])
+        let callTokens = ReasoningDelimiterTokens(config: qwen, tokenizer: withCall)
+        #expect(callTokens?.boundary(for: 3) == .implicitEnd("<tool_call>"))
+        #expect(callTokens?.implicitEndDelimiters == ["<tool_call>"])
+
+        // Only one of the two is a token: fall back to text for both.
+        let half = VocabularyTokenizer(vocabulary: [1: "<think>", 2: "</thi", 3: "nk>"])
+        #expect(ReasoningDelimiterTokens(config: qwen, tokenizer: half) == nil)
+
+        // A tokenizer that answers with an id for anything is not trusted.
+        #expect(ReasoningDelimiterTokens(config: qwen, tokenizer: AnyIDTokenizer()) == nil)
+    }
+
+    private struct AnyIDTokenizer: Tokenizer {
+        func encode(text: String, addSpecialTokens: Bool) -> [Int] { [7] }
+        func decode(tokenIds: [Int], skipSpecialTokens: Bool) -> String { "word" }
+        func convertTokenToId(_ token: String) -> Int? { 7 }
+        func convertIdToToken(_ id: Int) -> String? { "word" }
+        var bosToken: String? { nil }
+        var eosToken: String? { nil }
+        var unknownToken: String? { nil }
+        func applyChatTemplate(
+            messages: [[String: any Sendable]],
+            tools: [[String: any Sendable]]?,
+            additionalContext: [String: any Sendable]?
+        ) throws -> [Int] { [] }
+    }
+
+    // MARK: - Delimiter pairs
+
+    @Test("Delimiter tokens route a thought out of the answer")
+    func tokensRouteReasoning() {
+        let result = run([.open, "\nweigh ", "it", .close, "\n\nThe answer."], config: qwen)
+        #expect(result.reasoningText == "weigh it")
+        #expect(result.responseText == "The answer.")
+    }
+
+    @Test("A <think> spelled out in the answer stays in the answer")
+    func spelledOpenerInAnswerIsText() {
+        let result = run(
+            ["Wrap it in ", "<th", "ink>", " and ", "</think>", " tags."], config: qwen)
+        #expect(result.reasoning.isEmpty)
+        #expect(result.responseText == "Wrap it in <think> and </think> tags.")
+    }
+
+    @Test("A </think> spelled out in the middle of a thought does not close it")
+    func spelledCloserInThoughtIsText() {
+        let result = run(
+            [.open, "the tag ", "</think>", " ends it", .close, "Answer."], config: qwen)
+        #expect(result.reasoningText == "the tag </think> ends it")
+        #expect(result.responseText == "Answer.")
+    }
+
+    @Test("A <think> spelled out in the middle of a thought stays in the thought")
+    func spelledOpenerInThoughtIsText() {
+        let result = run([.open, "why ", "<think>", " here", .close, "Answer."], config: qwen)
+        #expect(result.reasoningText == "why <think> here")
+        #expect(result.responseText == "Answer.")
+    }
+
+    @Test("An opener token inside an open thought that never closes stays reasoning")
+    func nestedOpenerTokenNeverClosed() {
+        let result = run([.open, "first ", .open, "second"], config: qwen)
+        #expect(result.reasoningText == "first <think>second")
+        #expect(result.response.isEmpty)
+    }
+
+    @Test("A close token with no open thought is shown, as the text scan shows it")
+    func strayCloseTokenIsText() {
+        let result = run(["Answer ", .close, " more"], config: qwen)
+        #expect(result.reasoning.isEmpty)
+        #expect(result.responseText == "Answer </think> more")
+    }
+
+    @Test("A primed thought closes on the close token")
+    func primedThoughtCloses() {
+        let result = run(["reason", .close, "Answer."], config: qwen, primedInside: true)
+        #expect(result.reasoningText == "reason")
+        #expect(result.responseText == "Answer.")
+    }
+
+    @Test("A primed channel closes on the close token")
+    func primedChannelCloses() {
+        let result = run(
+            ["carried", .close, "Answer."], config: .gemma4, format: .gemma4, primedInside: true)
+        #expect(result.reasoningText == "carried")
+        #expect(result.responseText == "Answer.")
+    }
+
+    @Test("An opener token in the middle of the answer opens a thought")
+    func openerTokenMidAnswerOpensAThought() {
+        let result = run(["Answer ", .open, "more", .close, " done"], config: qwen)
+        #expect(result.reasoningText == "more")
+        #expect(result.responseText == "Answer done")
+    }
+
+    @Test("An implicit end delimiter that is not a token is still found as text")
+    func implicitEndStillScanned() {
+        let result = run(
+            [
+                .open, "need the file", "<tool_call>",
+                "{\"name\": \"read\", \"arguments\": {}}", "</tool_call>",
+            ], config: qwen)
+        #expect(result.reasoningText == "need the file")
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    private let call = "{\"name\": \"read\", \"arguments\": {}}"
+
+    @Test("A <tool_call> token ends an open thought and starts the call")
+    func toolCallTokenEndsThought() {
+        let result = run(
+            [.open, "need the file", .toolCall, .text(call), "</tool_call>"],
+            config: qwen, toolCallToken: true)
+        #expect(result.reasoningText == "need the file")
+        #expect(result.response.isEmpty)
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    @Test("A <tool_call> spelled out in a thought does not end it when it is a token")
+    func spelledToolCallInThoughtIsText() {
+        let result = run(
+            [.open, "the ", "<tool_", "call>", " tag starts a call", .close, "Answer."],
+            config: qwen, toolCallToken: true)
+        #expect(result.reasoningText == "the <tool_call> tag starts a call")
+        #expect(result.responseText == "Answer.")
+        #expect(result.toolCalls.isEmpty)
+    }
+
+    @Test("A spelled <tool_call> in a thought, then the token, ends the thought at the token")
+    func spelledThenTokenToolCall() {
+        let result = run(
+            [.open, "after ", "<tool_call>", " I call", .toolCall, .text(call), "</tool_call>"],
+            config: qwen, toolCallToken: true)
+        #expect(result.reasoningText == "after <tool_call> I call")
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    @Test("A <tool_call> token ends a primed thought")
+    func toolCallTokenEndsPrimedThought() {
+        let result = run(
+            ["need the file", .toolCall, .text(call), "</tool_call>"],
+            config: qwen, primedInside: true, toolCallToken: true)
+        #expect(result.reasoningText == "need the file")
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    @Test("A <tool_call> token after a closed thought is an ordinary call")
+    func toolCallTokenAfterThought() {
+        let result = run(
+            [.open, "plan", .close, "\n\n", .toolCall, .text(call), "</tool_call>"],
+            config: qwen, toolCallToken: true)
+        #expect(result.reasoningText == "plan")
+        #expect(result.response.isEmpty)
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    @Test("A <tool_call> token with no thought at all is an ordinary call")
+    func toolCallTokenWithoutThought() {
+        let result = run(
+            ["Reading. ", .toolCall, .text(call), "</tool_call>"],
+            config: qwen, toolCallToken: true)
+        #expect(result.reasoning.isEmpty)
+        #expect(result.responseText == "Reading. ")
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    @Test("A stop string equal to <tool_call> stops on its token inside a thought")
+    func stopStringOnToolCallToken() {
+        let result = run(
+            [.open, "thinking", .toolCall, .text(call), "</tool_call>"],
+            config: qwen, stopStrings: ["<tool_call>"], toolCallToken: true)
+        #expect(result.stopped)
+        #expect(result.reasoningText == "thinking")
+        #expect(result.toolCalls.isEmpty)
+    }
+
+    @Test("A <tool_call> token ends a channel whose label never ended")
+    func toolCallTokenDuringLabel() {
+        var config = ReasoningConfig.gemma4
+        config.implicitEndDelimiters = ["<tool_call>"]
+        let result = run(
+            [.open, "tho", .toolCall, .text(call), "</tool_call>"],
+            config: config, toolCallToken: true)
+        #expect(result.reasoningText == "tho")
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    @Test("Text held for a scanned implicit end precedes a <tool_call> token")
+    func heldTextPrecedesToolCallToken() {
+        var config = qwen
+        config.implicitEndDelimiters.append("<function=")
+        let result = run(
+            [.open, "about ", "<func", .toolCall, .text(call), "</tool_call>"],
+            config: config, toolCallToken: true)
+        #expect(result.reasoningText == "about <func")
+        #expect(result.toolCalls.map(\.function.name) == ["read"])
+    }
+
+    @Test("Text held before a boundary token is delivered ahead of it")
+    func heldTextPrecedesBoundary() {
+        // `<tool_c` is held as a possible implicit end until the close token arrives.
+        let result = run([.open, "about ", "<tool_c", .close, "Answer."], config: qwen)
+        #expect(result.reasoningText == "about <tool_c")
+        #expect(result.responseText == "Answer.")
+    }
+
+    @Test("A stop string equal to a delimiter still stops on its token")
+    func stopStringOnDelimiterToken() {
+        let result = run(
+            [.open, "thinking", .close, "never shown"], config: qwen, stopStrings: ["</think>"])
+        #expect(result.stopped)
+        #expect(result.reasoningText == "thinking")
+        #expect(result.response.isEmpty)
+    }
+
+    // MARK: - Labeled channels
+
+    @Test("Channel tokens route a thought channel and consume its label")
+    func channelTokensRoute() {
+        let result = run(
+            [.open, "thought\n", "step one", .close, "Final answer."],
+            config: .gemma4, format: .gemma4)
+        #expect(result.reasoningText == "step one")
+        #expect(result.responseText == "Final answer.")
+    }
+
+    @Test("Channel markers spelled out in the answer stay in the answer")
+    func spelledChannelMarkersInAnswerAreText() {
+        let result = run(
+            [
+                .open, "thought\n", "plan", .close,
+                "A channel opens with ", "<|channel>", "thought", " and ends with ", "<channel|>",
+                ".",
+            ],
+            config: .gemma4, format: .gemma4)
+        #expect(result.reasoningText == "plan")
+        #expect(
+            result.responseText
+                == "A channel opens with <|channel>thought and ends with <channel|>.")
+    }
+
+    @Test("Channel markers spelled out in a thought do not close or reopen it")
+    func spelledChannelMarkersInThoughtAreText() {
+        let result = run(
+            [
+                .open, "thought\n", "the ", "<channel|>", " then ", "<|channel>", " marker", .close,
+                "Done.",
+            ],
+            config: .gemma4, format: .gemma4)
+        #expect(result.reasoningText == "the <channel|> then <|channel> marker")
+        #expect(result.responseText == "Done.")
+    }
+
+    @Test("An opener token inside an open channel starts the next channel")
+    func nestedChannelTokenStartsNext() {
+        let result = run(
+            [.open, "thought\n", "a", .open, "thought\n", "b", .close, "c"],
+            config: .gemma4, format: .gemma4)
+        #expect(result.reasoningText == "ab")
+        #expect(result.responseText == "c")
+    }
+
+    @Test("A nested channel token that never closes flushes as reasoning")
+    func nestedChannelTokenNeverClosed() {
+        let result = run(
+            [.open, "thought\n", "a", .open, "thought\n", "b"],
+            config: .gemma4, format: .gemma4)
+        #expect(result.reasoningText == "ab")
+        #expect(result.response.isEmpty)
+    }
+
+    @Test("An opener token right after an opener token abandons the first label")
+    func openerTokenDuringLabel() {
+        let result = run(
+            [.open, "tho", .open, "thought\n", "b", .close, "c"],
+            config: .gemma4, format: .gemma4)
+        #expect(result.reasoningText == "thob")
+        #expect(result.responseText == "c")
+    }
+
+    @Test("A channel closed before its label ends is consumed whole")
+    func emptyChannelTokens() {
+        let result = run([.open, "thought", .close, "Answer."], config: .gemma4, format: .gemma4)
+        #expect(result.reasoning.isEmpty)
+        #expect(result.responseText == "Answer.")
+    }
+
+    @Test("A stray close token outside any channel is swallowed")
+    func strayChannelCloseToken() {
+        let result = run(["Answer ", .close, "more"], config: .gemma4, format: .gemma4)
+        #expect(result.reasoning.isEmpty)
+        #expect(result.responseText == "Answer more")
+    }
+
+    @Test("A response channel routes to the answer")
+    func responseChannelTokens() {
+        let result = run(
+            [.open, "thought\n", "plan", .close, .open, "content\n", "shown", .close],
+            config: .gemma4, format: .gemma4)
+        #expect(result.reasoningText == "plan")
+        #expect(result.responseText == "shown")
+    }
+
+    // MARK: - Token collector
+
+    @Test("The collector stops on the close token, not on its spelling")
+    func collectorIgnoresSpelledClose() {
+        let tokenizer = VocabularyTokenizer(vocabulary: [
+            1: "<think>", 2: "</think>", 3: "a ", 4: "</thi", 5: "nk>", 6: " b",
+        ])
+        var collector = ReasoningTokenCollector(
+            config: qwen, primedInside: false, tokenizer: tokenizer)
+        var segments: [ReasoningEventEmitter.Segment] = []
+        for token in [1, 3, 4, 5, 6] {
+            segments += collector.ingest(token)
+            #expect(!collector.shouldStopAfterReasoning)
+        }
+        segments += collector.ingest(2)
+        #expect(collector.shouldStopAfterReasoning)
+        segments += collector.finalize()
+
+        let reasoning = segments.compactMap { segment -> String? in
+            if case .reasoning(let text) = segment { return text }
+            return nil
+        }
+        #expect(reasoning.joined() == "a </think> b")
+        #expect(collector.reasoningTokenIDs == [1, 3, 4, 5, 6, 2])
+    }
+
+    @Test("The collector does not stop on an opener token inside an open thought")
+    func collectorNestedOpenerTokenDoesNotStop() {
+        let tokenizer = VocabularyTokenizer(vocabulary: [
+            1: "<think>", 2: "</think>", 3: "first ", 4: "second",
+        ])
+        var collector = ReasoningTokenCollector(
+            config: qwen, primedInside: false, tokenizer: tokenizer)
+        var segments: [ReasoningEventEmitter.Segment] = []
+        for token in [1, 3, 1, 4] {
+            segments += collector.ingest(token)
+            #expect(!collector.shouldStopAfterReasoning)
+        }
+        segments += collector.finalize()
+
+        let reasoning = segments.compactMap { segment -> String? in
+            if case .reasoning(let text) = segment { return text }
+            return nil
+        }
+        #expect(reasoning.joined() == "first <think>second")
+        #expect(collector.reasoningTokenIDs == [1, 3, 1, 4])
+    }
+
+    @Test("The collector stops on the <tool_call> token, not on its spelling")
+    func collectorStopsOnToolCallToken() {
+        let tokenizer = VocabularyTokenizer(vocabulary: [
+            1: "<think>", 2: "</think>", 3: "<tool_call>", 10: "a ", 11: "<tool_", 12: "call>",
+            13: " b",
+        ])
+        var collector = ReasoningTokenCollector(
+            config: qwen, primedInside: false, tokenizer: tokenizer)
+        var segments: [ReasoningEventEmitter.Segment] = []
+        for token in [1, 10, 11, 12, 13] {
+            segments += collector.ingest(token)
+            #expect(!collector.shouldStopAfterReasoning)
+        }
+        segments += collector.ingest(3)
+        #expect(collector.shouldStopAfterReasoning)
+        segments += collector.finalize()
+
+        #expect(reasoningText(segments) == "a <tool_call> b")
+        // The tag stays in the stream for the tool-call parser.
+        #expect(segments.last == .response("<tool_call>"))
+        #expect(collector.reasoningTokenIDs == [1, 10, 11, 12, 13, 3])
+    }
+
+    private func reasoningText(_ segments: [ReasoningEventEmitter.Segment]) -> String {
+        segments.compactMap { segment -> String? in
+            if case .reasoning(let text) = segment { return text }
+            return nil
+        }.joined()
+    }
+
+    // MARK: - Prompt priming by token
+
+    /// The template's prefill and a `<think>` the user typed share one token id.
+    /// Only position tells them apart: a prefill is the last thing in the prompt.
+    @Test("An opener token primes only when it ends the prompt")
+    func openerTokenPrimesOnlyAtTheEnd() {
+        let tokenizer = VocabularyTokenizer(vocabulary: [
+            1: "<think>", 2: "</think>", 10: "user\n", 11: "What does ", 12: " mean?",
+            13: "assistant\n", 14: "\n",
+        ])
+        func primed(_ tokens: [Int]) -> Bool {
+            ReasoningEventEmitter.promptEndsInsideReasoning(
+                promptTokens: tokens, config: qwen, tokenizer: tokenizer)
+        }
+        #expect(!primed([10, 11, 1, 12, 13]))
+        #expect(primed([10, 11, 1, 12, 13, 1, 14]))
+        #expect(!primed([10, 11, 1, 12, 13, 1, 14, 2, 14]))
+        #expect(!primed([]))
+    }
+
+    @Test("A prefill buried under more whitespace tokens than the tail holds still primes")
+    func prefillBeyondTheDecodedTailPrimes() {
+        let tokenizer = VocabularyTokenizer(vocabulary: [
+            1: "<think>", 2: "</think>", 10: "word ", 14: "\n",
+        ])
+        let padding = Array(
+            repeating: 14, count: ReasoningEventEmitter.promptTailTokenCount + 10)
+        #expect(
+            ReasoningEventEmitter.promptEndsInsideReasoning(
+                promptTokens: [10, 1] + padding, config: qwen, tokenizer: tokenizer))
+        #expect(
+            !ReasoningEventEmitter.promptEndsInsideReasoning(
+                promptTokens: [10, 1, 10] + padding, config: qwen, tokenizer: tokenizer))
+    }
+
+    @Test("Channel tokens prime only when an open channel ends the prompt")
+    func channelTokensPrime() {
+        let tokenizer = VocabularyTokenizer(vocabulary: [
+            1: "<|channel>", 2: "<channel|>", 10: "model\n", 11: "thought\n", 12: "user\n",
+            13: "What does ", 14: " mean?",
+        ])
+        func primed(_ tokens: [Int]) -> Bool {
+            ReasoningEventEmitter.promptEndsInsideReasoning(
+                promptTokens: tokens, config: .gemma4, tokenizer: tokenizer)
+        }
+        #expect(primed([10, 1, 11]))
+        #expect(!primed([10, 1, 11, 2]))
+        #expect(!primed([12, 13, 1, 14, 10]))
+    }
+}
