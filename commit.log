@@ -341,3 +392,36 @@ private final class StableTransitionLanguageModel: Module, LanguageModel, KVCach
         (token * 31 + 7) % vocabularySize
     }
 }
+
+/// Deterministic causal model predicting different transitions to induce rejections in speculative decoding.
+private final class DivergentTransitionLanguageModel: Module, LanguageModel,
+    KVCacheDimensionProvider
+{
+    let vocabularySize: Int
+    var kvHeads: [Int] { [] }
+
+    init(vocabularySize: Int) {
+        self.vocabularySize = vocabularySize
+        super.init()
+    }
+
+    func prepare(
+        _ input: LMInput, cache: [KVCache], state _: LMOutput.State?, prefill _: PrefillParameters
+    ) throws -> PrepareResult {
+        .tokens(input.text)
+    }
+
+    func callAsFunction(_ inputs: MLXArray, cache: [KVCache]?) -> MLXArray {
+        let tokenIds = inputs.asArray(Int.self)
+        var logits = Array(
+            repeating: Float(-100),
+            count: tokenIds.count * vocabularySize
+        )
+
+        for (position, token) in tokenIds.enumerated() {
+            logits[position * vocabularySize + ((token * 17 + 13) % vocabularySize)] = 100
+        }
+
+        return MLXArray(logits, [1, tokenIds.count, vocabularySize])
+    }
+}

commit d66761008139f4312269d9e931f69a404f2d1330
Author: xocialize <dustin.nielson@gmail.com>
Date:   Thu Aug 13 14:21:57 2026 -0700

    Expose Gemma 4 encoder surface at @_spi(GemmaEncoder) (#530)
    
    Expose Gemma 4 encoder surface at @_spi(GemmaEncoder)
    
    Mirrors #387's Gemma 3 exposure for Gemma 4, letting client code drive the
    decoder stack directly (e.g., an encoder-style tap collecting all hidden
    states) with Gemma 4 as a frozen text encoder.
    
    Exposed under @_spi(GemmaEncoder), off MLXLLM's public API but usable
    externally:
      * Gemma4TextConfiguration.hiddenSize / .numHiddenLayers
      * Gemma4DecoderLayer + callAsFunction
      * Gemma4TextModelInner (embedTokens/layers/norm/embedScale/config)
      * Gemma4TextModel.model
      * Gemma4Model.languageModel
    
    Differences from the Gemma 3 change:
    1. Gemma4SharedKVState: `package` → `public` (MLXLMCommon), required since it
       appears in callAsFunction's signature. Non-KV-sharing clients pass nil.
    2. Gemma4DecoderLayer's private-typed stored properties (selfAttn, mlp,
       router, experts) are now fileprivate — the narrowest fix for the class
       becoming public.
    
    Gemma4EncoderAccessTests validates the surface (like Gemma3EncoderAccessTests)
    using only exposed APIs, no @testable: state count, shapes, first-state ==
    scaled embedding, determinism, and actual layer transformation — on a tiny
    random model with no downloaded weights. Test config zeroes out
    per-layer/MoE/shared-KV settings, matching what a self-contained encoder tap
    sees.
    
    Critically, the test walks the real load path: it decodes a wrapped
    `gemma4_unified` config and reaches the text model via `Gemma4Model.languageModel`
    (previously `fileprivate`), rather than constructing `Gemma4TextModel` directly.
    Exposing only the inner types wasn't sufficient for an actual checkpoint load —
    a sufficiency test that skips the entry point proves the wrong thing.

