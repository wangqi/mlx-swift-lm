+        // GLM4 family (glm4, glm4_moe, glm4_moe_lite, etc.)
+        if type.hasPrefix("glm4") {
             return .glm4
-        case "gemma":
+        }
+
+        // Gemma
+        if type == "gemma" {
             return .gemma
-        default:
-            return nil
         }
+
+        return nil
     }
 }
