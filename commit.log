+            tailTokens: tokens[(tokens.size - count)...].asArray(Int.self),
+            isWholePrompt: count == tokens.size,
+            config: config, tokenizer: tokenizer)
+        if let primed { return primed }
+        count = min(tokens.size, count * 2)
+    }
