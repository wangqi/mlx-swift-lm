+    private static func from(_ number: NSNumber) -> JSONValue {
+        if CFGetTypeID(number) == CFBooleanGetTypeID() {
+            return .bool(number.boolValue)
+        }
+        if let int = number as? Int {
+            return .int(int)
+        }
+        return .double(number.doubleValue)
+    }
