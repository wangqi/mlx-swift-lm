+++            self.values = array
+++        } else if let single = try? container.decode(Int.self) {
+++            self.values = [single]
+++        } else {
+++            throw DecodingError.typeMismatch(
+++                IntOrArray.self,
+++                DecodingError.Context(
+++                    codingPath: decoder.codingPath,
+++                    debugDescription: "Expected Int or [Int]"
