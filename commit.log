+
+private func tinyDSparkConfiguration() throws -> LFM2DSparkConfiguration {
+    try JSONDecoder().decode(
+        LFM2DSparkConfiguration.self, from: Data(tinyLFM2DSparkJSON.utf8))
+}
+
+private func tinyDSparkTarget() throws -> LFM2Model {
+    LFM2Model(
