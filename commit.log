+    func testMoERouterTopKMatchesChainAcrossDispatchPaths() {
+        let cases = [
+            (shape: [1, 256], k: 8, label: "single-row fused"),
+            (shape: [4, 256], k: 8, label: "multi-row chain"),
+            (shape: [1, 1025], k: 8, label: "expert-limit chain"),
+        ]
