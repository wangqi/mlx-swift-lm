++++    static let llmModelId = "mlx-community/Qwen3-4B-Instruct-2507-4bit"
++++    static let vlmModelId = "mlx-community/Qwen3-VL-4B-Instruct-4bit"
++++    static var llmContainer: ModelContainer!
