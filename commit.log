+    /// token's text.
+    private func specialTokenNames(inIDs ids: [Int]) -> [String] {
+        var names: [String] = []
+        var seen = Set<Int>()
+        for id in ids where containsSpecialToken([id]) {
+            guard seen.insert(id).inserted else { continue }
+            names.append(convertIdToToken(id) ?? "token \(id)")
+        }
+        return names
+    }
+}
