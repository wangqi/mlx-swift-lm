+    func testMTP31BMatchesBaselineRainbowsPrompt() async throws {
+        try await runMTPVsBaselineByteIdentityCheck(
+            prompt: "Write a paragraph about how rainbows form.",
+            maxTokens: 32
+        )
+    }
