+++++            queries: queries,
+++++            keys: keys,
+++++            values: values,
+++++            cache: cache,
+++++            scale: scale,
+++++            mask: mask
+++++        )
+++++        .transposed(0, 2, 1, 3)
+++++        .reshaped(B, L, -1)
