+++-    ///   - videos: list of video (for use with VLMs)
+++-    /// - Returns: a stream of tokens (as Strings) from the model
+++-    public func streamResponse(
+++-        to prompt: String,
+++-        images: [UserInput.Image],
+++-        videos: [UserInput.Video]
+++-    ) -> AsyncThrowingStream<String, Error> {
+++-        generator.messages = [
+++-            .user(
