diff --git a/Tests/MLXLMTests/PrefillClearCacheTests.swift b/Tests/MLXLMTests/PrefillClearCacheTests.swift
new file mode 100644
index 0000000..f7ba788
--- /dev/null
+++ b/Tests/MLXLMTests/PrefillClearCacheTests.swift
@@ -0,0 +1,34 @@
+// Copyright © 2026 Apple Inc.
+
+import MLX
+import MLXLMCommon
+import XCTest
+
+final class PrefillClearCacheTests: XCTestCase {
+
+    // Buffers a chunk leaves behind, such as a KV cache the next chunk outgrows,
+    // must not stay in the buffer cache for the rest of the prefill.
+    func testEachChunkClearsBufferCache() throws {
+        let seeded = 256 * 1024 * 1024
+        var cached: [Int] = []
+        let processed = try PrefillParameters(stepSize: 4).forEachChunk(total: 9) { range in
+            cached.append(Memory.cacheMemory)
+            do {
+                let buffer = MLXArray.zeros([seeded], dtype: .uint8) + range.lowerBound + 1
+                eval(buffer)
+            }
+            // A freed buffer reaches the cache only after the GPU releases it on another
+            // thread, so wait for it before the driver clears the cache.
+            let deadline = Date().addingTimeInterval(1)
+            while Memory.cacheMemory < seeded, Date() < deadline {
+                usleep(1000)
+            }
+            XCTAssertGreaterThanOrEqual(Memory.cacheMemory, seeded)
+        }
+
+        XCTAssertEqual(processed, 8)
+        XCTAssertEqual(cached.count, 2)
+        XCTAssertLessThan(cached[1], seeded / 4)
+        XCTAssertLessThan(Memory.cacheMemory, seeded / 4)
+    }
+}

commit db2e7bf48ec054a7dd6f2419ed24fbda285fc922
Author: Alessio Pollero <alessio.pollero@gmail.com>
Date:   Sat Oct 24 00:18:07 2026 +0400

    Expose request-scoped generation observations in ChatSession (#714)
    
    Expose ordered token log probabilities from ChatSession
    
    Add a request-scoped streamDetails overload built on #640's composed
    handler, so callers can inspect the actual cached reply and group tool
    passes by completion event. Ordinary streams and existing public enum
    cases are unchanged.
    
    Add observe(to:using:) with request-local transformer configuration and
    a fresh handler for each generation pass. Base events, cached-prompt
    metadata, tool dispatch, and cancellation are preserved.
    
    Add compatibility, cancellation, rejection, cache, and real-model tests.
    
    Developed with Codex assistance.

diff --git a/IntegrationTesting/IntegrationTestingTests/GenerationObservabilityIntegrationTests.swift b/IntegrationTesting/IntegrationTestingTests/GenerationObservabilityIntegrationTests.swift
index 4748477..471ba9e 100644
--- a/IntegrationTesting/IntegrationTestingTests/GenerationObservabilityIntegrationTests.swift
+++ b/IntegrationTesting/IntegrationTestingTests/GenerationObservabilityIntegrationTests.swift
@@ -79,4 +79,58 @@ struct GenerationObservabilityIntegrationTests {
             }
         }
     }
+
+    @Test(arguments: [
+        "mlx-community/Llama-3.2-1B-Instruct-4bit",
+        "mlx-community/Qwen3.5-4B-4bit",
+    ])
+    func cachedSessionObservationPreservesGeneration(_ modelID: String) async throws {
+        let container = try await models.llmContainer(for: ModelConfiguration(id: modelID))
+        let parameters = GenerateParameters(maxTokens: 24, temperature: 0)
+        let plain = ChatSession(
+            container, generateParameters: parameters,
+            additionalContext: ["enable_thinking": false])
+        let observed = ChatSession(
+            container, generateParameters: parameters,
+            additionalContext: ["enable_thinking": false])
+        for prompt in ["What is 2 + 2? Answer in one sentence.", "Now add 1 to that answer."] {
+            var expected = ""
+            var expectedInfo: GenerateCompletionInfo?
+            for try await event in plain.streamDetails(to: prompt) {
+                if let text = event.chunk { expected += text }
+                if let info = event.info { expectedInfo = info }
+            }
+            var probabilities: [GenerateTokenLogProbabilities] = []
+            var actual = ""
+            var actualInfo: GenerateCompletionInfo?
+            for try await event in observed.observe(
+                to: prompt, using: .logProbabilities(topCount: 4))
+            {
+                if let value = event.logProbabilities { probabilities.append(value) }
+                if let generation = event.generation {
+                    if let text = generation.chunk { actual += text }
+                    if let info = generation.info { actualInfo = info }
+                }
+            }
+            let expectedCompletion = try #require(expectedInfo)
+            let actualCompletion = try #require(actualInfo)
+            #expect(!expected.isEmpty)
+            #expect(actual == expected)
+            #expect(
+                actualCompletion.generationTokenCount == expectedCompletion.generationTokenCount)
+            #expect(
+                actualCompletion.cachedPromptTokenCount == expectedCompletion.cachedPromptTokenCount
+            )
+            #expect(probabilities.count == actualCompletion.generationTokenCount)
+            #expect(
+                probabilities.allSatisfy {
+                    $0.chosen.logProbability.isFinite && $0.chosen.logProbability <= 0
+                        && $0.topLogProbabilities.count == 4
+                })
+            print(
+                "ChatSession observation: \(modelID), cached tokens \(actualCompletion.cachedPromptTokenCount), generated tokens \(actualCompletion.generationTokenCount)"
+            )
+        }
+    }
+
 }
