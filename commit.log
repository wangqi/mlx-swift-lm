index 58335e5..9e248a1 100644
--- a/Libraries/MLXLMCommon/GatedDelta.swift
+++ b/Libraries/MLXLMCommon/GatedDelta.swift
@@ -230,6 +230,59 @@ private func gatedDeltaStepOps(
