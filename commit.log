++        self.tieWordEmbeddings =
++            try container.decodeIfPresent(Bool.self, forKey: .tieWordEmbeddings) ?? false
++        self.numExperts = try container.decodeIfPresent(Int.self, forKey: .numExperts) ?? 128
++        self.numExpertsPerTok =
