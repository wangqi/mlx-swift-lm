+    func testMediaProcessingSampledFrameCountHonorsMaxFramesForInMemoryVideoFrames() {
+        let duration = CMTime(value: 9, timescale: 1)
+
+        XCTAssertEqual(
+            MediaProcessing.sampleTimes(
