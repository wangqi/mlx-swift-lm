+extension EmbeddingGemma2Tests {
+    private struct MediaCheckpoint {
+        let directory: URL
+        let configuration: EmbeddingGemma2Configuration
+        let precision: BaseConfiguration.PerLayerQuantization?
+    }
+
+    private static func mediaCheckpoint(scoped: Bool = false, quantized: Bool = false) throws
+        -> MediaCheckpoint
+    {
+        let configuration = try decode(tinyMediaConfig)
+        let source = EmbeddingGemma2(configuration)
+        try source.update(
+            parameters: .unflattened(try deterministicWeights(for: source)), verify: .all)
+        let override = "audio_tower.layers.0.self_attn.q_proj.linear"
+        if quantized {
+            MLXNN.quantize(
+                model: source,
+                filter: { path, module -> (Int, Int, QuantizationMode)? in
+                    let weight = (module as? Linear)?.weight ?? (module as? Embedding)?.weight
+                    guard let weight, weight.dim(-1) % 32 == 0 else { return nil }
+                    return (32, path == override ? 8 : 4, .affine)
+                })
+        }
+        let precision: BaseConfiguration.PerLayerQuantization? =
+            quantized
+            ? .init(
+                quantization: .init(groupSize: 32, bits: 4),
+                perLayerQuantization: [
+                    (scoped ? "model." : "") + override: .quantize(.init(groupSize: 32, bits: 8))
+                ]) : nil
+        var weights = Dictionary(uniqueKeysWithValues: source.parameters().flattened())
+        // Exercise convolution conversion after audio has detached, in both checkpoint layouts.
+        for (key, value) in weights
+        where key.hasSuffix(".conv.weight") || key.hasSuffix(".depthwise_conv1d.weight") {
+            weights[key] = value.movedAxis(source: -1, destination: 1)
+        }
+        if scoped {
+            weights = Dictionary(
+                uniqueKeysWithValues: weights.map { ("model." + $0.key, $0.value) })
+        }
+        let directory = try processorDirectory("{}")
+        var json =
+            try JSONSerialization.jsonObject(with: Data(tinyMediaConfig.utf8)) as! [String: Any]
+        json["model_type"] = "embedding_gemma2"
+        if quantized {
+            json["quantization"] =
+                [
+                    "group_size": 32, "bits": 4, "mode": "affine",
+                    (scoped ? "model." : "") + override: ["group_size": 32, "bits": 8],
+                ] as [String: Any]
+        }
+        try JSONSerialization.data(withJSONObject: json).write(
+            to: directory.appendingPathComponent("config.json"))
+        try save(arrays: weights, url: directory.appendingPathComponent("model.safetensors"))
+        return MediaCheckpoint(
+            directory: directory, configuration: configuration, precision: precision)
+    }
+
+    private static var imagePixels: MLXArray {
+        MLXArray((0 ..< 3 * 16 * 16).map { Float($0 % 251) / 250 }, [1, 3, 16, 16])
+    }
+
+    private static var audioFrames: MLXArray {
+        MLXArray((0 ..< 44 * 8).map { Float(sin(Double($0) * 0.17)) }, [44, 8])
+    }
+
+    private static func textVector(_ model: EmbeddingGemma2) -> MLXArray {
+        model.embed(inputIds: MLXArray([2, 15, 18, 20, 1] as [Int32], [1, 5]), attentionMask: nil)
+    }
+
+    @Test(arguments: [false, true], [false, true])
+    func onDemandEncodersMatchImmediateWithoutChangingTheModel(scoped: Bool, quantized: Bool) throws
+    {
+        let checkpoint = try Self.mediaCheckpoint(scoped: scoped, quantized: quantized)
+        defer { try? FileManager.default.removeItem(at: checkpoint.directory) }
+        let immediate = EmbeddingGemma2(checkpoint.configuration)
+        try loadWeights(
+            modelDirectory: checkpoint.directory, model: immediate,
+            perLayerQuantization: checkpoint.precision, componentLoading: .immediate)
+        let lazy = EmbeddingGemma2(checkpoint.configuration)
+        try loadWeights(
+            modelDirectory: checkpoint.directory, model: lazy,
+            perLayerQuantization: checkpoint.precision)
+        let parameters = lazy.parameters().flattened().map(\.0)
+        #expect(parameters.allSatisfy { $0.hasPrefix("language_model.") })
+        #expect(lazy.onDemandComponents.allSatisfy { !$0.isLoaded })
+        #expect(arrayEqual(Self.textVector(lazy), Self.textVector(immediate)).item(Bool.self))
+
+        let image = try #require(try lazy.imageFeatures(Self.imagePixels))
+        let imageReference = try #require(try immediate.imageFeatures(Self.imagePixels))
+        #expect(arrayEqual(image, imageReference).item(Bool.self))
+        #expect(lazy.onDemandComponents.first { $0.component == .vision }?.isLoaded == true)
+        #expect(lazy.onDemandComponents.first { $0.component == .audio }?.isLoaded == false)
+        let audio = try #require(try lazy.audioFeatures(Self.audioFrames))
+        let audioReference = try #require(try immediate.audioFeatures(Self.audioFrames))
+        #expect(arrayEqual(audio, audioReference).item(Bool.self))
+
+        let ids = try EmbeddingGemma2Sequence.tokens(
+            [.text([15]), .image(tokens: image.dim(1)), .audio(tokens: audio.dim(1))],
+            configuration: checkpoint.configuration, beginOfSequence: 2, endOfSequence: 1,
+            limit: 256)
+        let input = MLXArray(ids.map(Int32.init), [1, ids.count])
+        let actual = lazy.embed(
+            inputIds: input, attentionMask: nil,
+            softTokens: concatenated([image[0], audio[0]]))
+        let expected = immediate.embed(
+            inputIds: input, attentionMask: nil,
+            softTokens: concatenated([imageReference[0], audioReference[0]]))
+        #expect(arrayEqual(actual, expected).item(Bool.self))
+        #expect(lazy.parameters().flattened().map(\.0) == parameters)
+        #expect(lazy.onDemandComponents.allSatisfy { $0.isLoaded })
+
+        // Conversion can rebuild the detached modules and save a complete checkpoint.
+        try loadWeights(
+            modelDirectory: checkpoint.directory, model: lazy,
+            perLayerQuantization: checkpoint.precision, componentLoading: .immediate)
+        #expect(
+            Set(lazy.parameters().flattened().map(\.0))
+                == Set(immediate.parameters().flattened().map(\.0)))
+        #expect(
+            arrayEqual(try #require(try lazy.audioFeatures(Self.audioFrames)), audioReference).item(
+                Bool.self))
+    }
+
+    @Test(arguments: [[ModelComponent.vision], [.audio], [.vision, .audio]])
+    func excludedComponentsNeverLoad(_ components: [ModelComponent]) throws {
+        let checkpoint = try Self.mediaCheckpoint()
+        defer { try? FileManager.default.removeItem(at: checkpoint.directory) }
+        let model = EmbeddingGemma2(checkpoint.configuration)
+        try loadWeights(
+            modelDirectory: checkpoint.directory, model: model, excludedComponents: Set(components))
+        let before = Self.textVector(model).asArray(Float.self)
+        for holder in model.onDemandComponents where components.contains(holder.component) {
+            #expect(throws: OnDemandComponentError.self) { try holder.loadModule() }
+            #expect(!holder.isLoaded)
+        }
+        #expect(model.supportedComponents == Set([.vision, .audio]).subtracting(components))
+        #expect(Self.textVector(model).asArray(Float.self) == before)
+    }
+
+    @Test
+    func textOnlyCheckpointKeepsItsMultimodalConfigurationAndNeedsNoProcessor() async throws {
+        let checkpoint = try Self.mediaCheckpoint()
+        defer { try? FileManager.default.removeItem(at: checkpoint.directory) }
+        let url = checkpoint.directory.appendingPathComponent("model.safetensors")
+        let text = try loadArrays(url: url).filter { $0.key.hasPrefix("language_model.") }
+        eval(Array(text.values))
+        try save(arrays: text, url: url)
+        try FileManager.default.removeItem(
+            at: checkpoint.directory.appendingPathComponent("processor_config.json"))
+        let context = try await EmbedderModelFactory.shared.load(
+            from: checkpoint.directory, using: TestTokenizerLoader())
+        let model = try #require(context.model as? MLXLMCommon.EmbeddingGemma2)
+        #expect(model.config.vision != nil && model.config.audio != nil)
+        let before = Self.textVector(model).asArray(Float.self)
+        #expect(before.allSatisfy { $0.isFinite })
+        #expect(throws: UpdateError.self) { try model.imageFeatures(Self.imagePixels) }
+        #expect(Self.textVector(model).asArray(Float.self) == before)
+        let actor = try await EmbeddingGemma2Embedding(
+            modelDirectory: checkpoint.directory, tokenizerLoader: TestTokenizerLoader())
+        #expect(try await actor.embed(.init(text: "Swift"), task: .codeRetrieval).count == 12)
+        let excluded = try await EmbeddingGemma2Embedding(
+            modelDirectory: checkpoint.directory,
+            tokenizerLoader: TestTokenizerLoader(), excludedComponents: [.vision, .audio])
+        #expect(await excluded.supportedModalities == [.text])
+    }
+
+    @Test
+    func failedMediaLoadCanRetryWithoutPublishingPartialWeights() throws {
+        let checkpoint = try Self.mediaCheckpoint()
+        defer { try? FileManager.default.removeItem(at: checkpoint.directory) }
+        let url = checkpoint.directory.appendingPathComponent("model.safetensors")
+        let complete = try Data(contentsOf: url)
+        let model = EmbeddingGemma2(checkpoint.configuration)
+        try loadWeights(modelDirectory: checkpoint.directory, model: model)
+        let before = Self.textVector(model).asArray(Float.self)
+        let text = try loadArrays(url: url).filter { $0.key.hasPrefix("language_model.") }
+        eval(Array(text.values))
+        try save(arrays: text, url: url)
+        #expect(throws: UpdateError.self) { try model.imageFeatures(Self.imagePixels) }
+        #expect(model.onDemandComponents.allSatisfy { !$0.isLoaded })
+        #expect(Self.textVector(model).asArray(Float.self) == before)
+        try complete.write(to: url)
+        #expect(try model.imageFeatures(Self.imagePixels) != nil)
+        #expect(model.onDemandComponents.first { $0.component == .vision }?.isLoaded == true)
+    }
+
+    private final class LoadedModules: @unchecked Sendable {
+        private let lock = NSLock()
+        private var modules: [ModelComponent: Set<ObjectIdentifier?>] = [:]
+        func record(_ module: Module?, for component: ModelComponent) {
+            lock.withLock {
+                modules[component, default: []].insert(module.map(ObjectIdentifier.init))
+            }
+        }
+        func identities(for component: ModelComponent) -> Set<ObjectIdentifier?> {
+            lock.withLock { modules[component, default: []] }
+        }
+    }
+
+    @Test
+    func concurrentFirstUsesShareOneFullyLoadedEncoder() throws {
+        let checkpoint = try Self.mediaCheckpoint(quantized: true)
+        defer { try? FileManager.default.removeItem(at: checkpoint.directory) }
+        let model = EmbeddingGemma2(checkpoint.configuration)
+        try loadWeights(
+            modelDirectory: checkpoint.directory, model: model,
+            perLayerQuantization: checkpoint.precision)
+        let vision = try #require(model.onDemandComponents.first { $0.component == .vision })
+        let audio = try #require(model.onDemandComponents.first { $0.component == .audio })
+        let loaded = LoadedModules()
+        DispatchQueue.concurrentPerform(iterations: 8) { index in
+            let holder = index.isMultiple(of: 2) ? vision : audio
+            loaded.record(try? holder.loadModule(), for: holder.component)
+        }
+        for holder in [vision, audio] {
+            #expect(
+                loaded.identities(for: holder.component) == [
+                    ObjectIdentifier(try holder.loadModule())
+                ])
+        }
+        #expect(model.parameters().flattened().allSatisfy { $0.0.hasPrefix("language_model.") })
+    }
+
+    @Test
+    func mediaPreloadingUsesTheExistingBackgroundLoader() async throws {
+        let checkpoint = try Self.mediaCheckpoint()
+        defer { try? FileManager.default.removeItem(at: checkpoint.directory) }
+        let model = EmbeddingGemma2(checkpoint.configuration)
+        try await loadWeights(modelDirectory: checkpoint.directory, model: model)
+        let holder = try #require(model.onDemandComponents.first { $0.component == .audio })
+        let gate = NSLock()
+        var queue = ""
+        holder.setSource(
+            .init(
+                urls: [checkpoint.directory.appendingPathComponent("model.safetensors")],
+                namespaces: model.modelComponents[.audio]!.flatMap(\.namespaces),
+                perLayerQuantization: nil,
+                prepare: { checkpoint in
+                    gate.withLock { queue = String(cString: __dispatch_queue_get_label(nil)) }
+                    return try model.prepareCheckpoint(checkpoint)
+                }))
+        try await model.loadMediaComponents([.audio])
+        #expect(holder.isLoaded)
+        #expect(
+            gate.withLock { queue.hasPrefix("com.apple.root.") && !queue.contains("cooperative") })
+        #expect(model.onDemandComponents.first { $0.component == .vision }?.isLoaded == false)
+    }
+}

