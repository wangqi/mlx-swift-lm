Author: Tolga Unal <115488770+unaltolga@users.noreply.github.com>
Date:   Tue Nov 10 12:21:31 2026 -0500

    Parse triple-quoted strings in PythonLiteralParser (#786)
    
    A Pythonic tool call that writes a multi-line value as a triple-quoted
    string, like content="""...""", was rejected, so the tool got the raw text
    with its quotes. The parser now reads triple-quoted strings as Python
    does: the string ends at the next three quotes and may contain newlines
    and single quotes.

diff --git a/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift b/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift
index fc37e5e..8774275 100644
--- a/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift
+++ b/Libraries/MLXLMCommon/Tool/Parsers/PythonLiteralParser.swift
@@ -108,11 +108,27 @@ struct PythonLiteralParser {
         guard let quote = current, quote == "'" || quote == "\"" else { return nil }
         advance()
 
+        // A triple-quoted string may span lines and ends at the next three quotes.
+        let isTripleQuoted = startsWith(quote, count: 2)
+        if isTripleQuoted {
+            advance()
+            advance()
+        }
+
         var result = ""
         while let character = current {
             advance()
 
-            if character == quote { return result }
+            if character == quote {
+                guard isTripleQuoted else { return result }
+                if startsWith(quote, count: 2) {
+                    advance()
+                    advance()
+                    return result
+                }
+                result.append(character)
+                continue
+            }
             guard character == "\\" else {
                 result.append(character)
                 continue
@@ -224,6 +240,11 @@ struct PythonLiteralParser {
         return nil
     }
 
+    /// Whether the next `count` characters are all `character`.
+    private func startsWith(_ character: Character, count: Int) -> Bool {
+        source[index...].prefix(count).elementsEqual(repeatElement(character, count: count))
+    }
+
     private mutating func skipWhitespace() {
         while current?.isWhitespace == true { advance() }
     }
