+            for (uint i = 0; i < DIMS_PER_LANE; i++) {
+                uint d = lane + i * 32;
+                if (d >= Dim) break;
+
+                uint v_bit_offset = d * ValueBits;
+                uint v_word_idx = v_bit_offset / 32;
+                uint v_shift = v_bit_offset % 32;
+                uint v_value = (v_packed_ptr[v_word_idx] >> v_shift);
